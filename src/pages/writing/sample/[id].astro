---
import SampleArticlePage from '../../../components/pages/SampleArticlePage.astro';
import { catalogPosts, type CatalogPost } from '../../../data/blog-catalog';
export function getStaticPaths() {
  return catalogPosts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}
interface Props {
  post: CatalogPost;
}
---

<SampleArticlePage post={Astro.props.post} lang="en" />
