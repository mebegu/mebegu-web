---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectPanel from '../projects/ProjectPanel.astro';
import ProjectVisual from '../projects/ProjectVisual.astro';
import type { Lang } from '../../lib/i18n';
import { projectUrl } from '../../lib/project-content';
import { projects, projectKinds, projectStatuses } from '../../data/projects';
import '../../styles/projects.css';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = lang === 'tr';
---

<BaseLayout
  title={tr ? 'Atölye' : 'Workshop'}
  lang={lang}
  bodyClass="projects-body"
  description={
    tr
      ? 'Uygulamalar, araçlar, kütüphaneler, oyunlar ve deneyler. Tamamlananlar, sürenler ve arada kalanlar.'
      : 'Apps, utilities, libraries, games and experiments. Finished, in progress, and somewhere in between.'
  }
>
  <div class="projects-page" data-workshop data-lang={lang}>
    <header class="projects-heading">
      <div>
        <p class="eyebrow">
          {tr ? 'Kişisel proje atölyesi' : 'The personal workbench'}
        </p>
        <h1>
          {tr ? 'Atölye' : 'Workshop'}
          <span class="accent">.</span>
        </h1>
      </div>
      <p class="projects-intro">
        {tr
          ? 'İşe yarayan küçük şeyler, kurcaladığım fikirler. Bitenler, sürenler ve arada kalanlar.'
          : 'Useful little things and ideas I keep exploring. Finished, in progress, and somewhere in between.'}
      </p>
    </header>
    <div class="workshop-controls" data-workshop-controls hidden>
      <div
        class="project-filters"
        role="group"
        aria-label={tr ? 'Proje türü' : 'Project type'}
      >
        <button
          type="button"
          data-kind="all"
          aria-pressed="true"
          aria-controls="workshop-list"
        >
          {tr ? 'Tümü' : 'All'}
          <span>{projects.length}</span>
        </button>
        {projectKinds
          .filter((kind) =>
            projects.some((project) => project.kind === kind.id),
          )
          .map((kind) => (
            <button
              type="button"
              data-kind={kind.id}
              aria-pressed="false"
              aria-controls="workshop-list"
            >
              {kind.label[lang]}
              <span>
                {projects.filter((project) => project.kind === kind.id).length}
              </span>
            </button>
          ))}
      </div>
      <div class="workshop-refine">
        <label class="workshop-search">
          <span>{tr ? 'Proje ara' : 'Search projects'}</span>
          <input
            type="search"
            data-workshop-search
            placeholder={
              tr
                ? 'Bir fikir, araç, teknoloji…'
                : 'An idea, utility, technology…'
            }
            aria-controls="workshop-list"
          />
        </label>
        <label class="workshop-status-filter">
          <span>{tr ? 'Projenin durumu' : 'Project status'}</span>
          <select data-workshop-status aria-controls="workshop-list">
            <option value="all">{tr ? 'Tüm durumlar' : 'All statuses'}</option>
            {projectStatuses.map((status) => (
              <option value={status.id}>{status.label[lang]}</option>
            ))}
          </select>
        </label>
      </div>
    </div>
    <div class="workshop-topline">
      <p
        data-workshop-count
        aria-live="polite"
        aria-atomic="true"
        data-count-label={tr ? 'proje' : 'projects'}
        data-count-label-singular={tr ? 'proje' : 'project'}
      >
        {projects.length}{' '}
        {tr ? 'proje' : projects.length === 1 ? 'project' : 'projects'}
      </p>
    </div>
    <p
      class="sr-only"
      data-workshop-announcement
      aria-live="polite"
      aria-atomic="true"
    ></p>
    <div class="workshop-workbench">
      <div class="workshop-index">
        <ul
          class="project-index-list"
          id="workshop-list"
          aria-label={
            tr ? 'İncelemek için bir proje seç' : 'Choose a project to explore'
          }
        >
          {projects.map((project) => (
            <li
              class="project-index-item"
              data-project-entry={project.id}
              data-project-kind={project.kind}
              data-project-state={project.status}
              data-search={[
                ...Object.values(project.title),
                ...Object.values(project.hook),
                ...project.technologies,
                projectKinds.find((kind) => kind.id === project.kind)!.label[
                  lang
                ],
                projectStatuses.find((status) => status.id === project.status)!
                  .label[lang],
              ].join(' ')}
            >
              <a
                class="project-index-link"
                href={`#project-${project.id}`}
                data-project-select={project.id}
                aria-controls={`project-${project.id}`}
              >
                <span
                  class={`project-index-visual media-${project.visual}`}
                  aria-hidden="true"
                >
                  {project.media[0]?.type === 'screenshot' ? (
                    <img
                      src={projectUrl(project.media[0].src, lang)!}
                      alt=""
                      width="72"
                      height="72"
                      loading="lazy"
                    />
                  ) : (
                    <ProjectVisual visual={project.visual} />
                  )}
                </span>
                <span class="project-index-copy">
                  <strong>{project.title[lang]}</strong>
                  <span class="project-index-hook">{project.hook[lang]}</span>
                  <span class={`project-index-status status-${project.status}`}>
                    {
                      projectStatuses.find(
                        (status) => status.id === project.status,
                      )!.label[lang]
                    }
                  </span>
                </span>
                <span class="project-index-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))}
        </ul>
        <button class="workshop-more" type="button" data-workshop-more hidden>
          {tr ? 'Diğer projeleri göster' : 'Show more projects'}
        </button>
        <div class="workshop-empty" data-workshop-empty hidden>
          <p>
            {tr
              ? 'Bu seçimle eşleşen proje yok.'
              : 'No projects match this selection.'}
          </p>
          <button type="button" data-workshop-reset>
            {tr ? 'Bütün projeleri göster' : 'Show all projects'}
          </button>
        </div>
      </div>
      <div class="project-detail-area" data-project-detail-area>
        {projects.map((project) => (
          <ProjectPanel project={project} lang={lang} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
<script>
  import { initWorkshop } from '../../lib/workshop';
  document
    .querySelectorAll<HTMLElement>('[data-workshop]')
    .forEach(initWorkshop);
</script>
