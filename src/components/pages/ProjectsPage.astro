---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectVisual from '../projects/ProjectVisual.astro';
import { type Lang } from '../../lib/i18n';
import { href } from '../../lib/urls';
import { projects, projectKinds } from '../../data/projects';
import '../../styles/projects.css';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<BaseLayout
  title="Projects"
  lang={lang}
  bodyClass="projects-body"
  description="Selected software, cloud, data and interactive projects by Mehmet Berk Gürçay."
>
  <div class="projects-page" data-projects-page lang="en">
    <header class="projects-heading">
      <div>
        <p class="eyebrow">Selected projects</p>
        <h1>
          Projects<span class="accent">.</span>
        </h1>
      </div>
      <p class="projects-intro">
        Cloud platforms, data-driven applications and interactive experiences.
        An outline of the work I’ve contributed to.
      </p>
    </header>
    <div class="projects-topline">
      <div
        class="project-filters"
        data-project-filters
        role="group"
        aria-label="Project category"
        hidden
      >
        <button
          type="button"
          data-project-filter="all"
          aria-pressed="true"
          aria-controls="project-list"
        >
          All{' '}
          <span aria-hidden="true">
            {String(projects.length).padStart(2, '0')}
          </span>
        </button>
        {projectKinds.map((kind) => (
          <button
            type="button"
            data-project-filter={kind.id}
            aria-pressed="false"
            aria-controls="project-list"
          >
            {kind.label}
            <span aria-hidden="true">
              {String(
                projects.filter((project) => project.kind === kind.id).length,
              ).padStart(2, '0')}
            </span>
          </button>
        ))}
      </div>
      <p class="projects-template-note">
        Project outlines · More detail to come
      </p>
    </div>
    <p
      class="sr-only"
      data-project-status
      aria-live="polite"
      aria-atomic="true"
      data-count-label="projects shown"
    ></p>
    <section
      id="project-list"
      class="project-grid"
      aria-label="Project showcase"
    >
      {projects.map((project, index) => (
        <article
          id={project.id}
          class:list={[
            'project-card',
            `project-kind-${project.kind}`,
            { 'project-card-featured': index === 0 },
          ]}
          data-project-kind={project.kind}
        >
          <div class={`project-media media-${project.visual}`}>
            <div class="project-media-grid" aria-hidden="true"></div>
            <div class="project-media-top">
              <span>
                {String(index + 1).padStart(2, '0')} /{' '}
                {projectKinds.find((kind) => kind.id === project.kind)?.label}
              </span>
            </div>
            {project.image ? (
              <img
                class="project-screenshot"
                src={href(project.image)}
                alt={project.title}
                width="680"
                height="440"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <ProjectVisual visual={project.visual} />
            )}
            {!project.image && (
              <p class="project-visual-caption">
                Illustrative visual · Project screenshot to come
              </p>
            )}
          </div>
          <div class="project-card-copy">
            <p class="project-kind-label">
              {project.organization}
              {project.period && ` · ${project.period}`}
            </p>
            <h2>{project.title}</h2>
            <p class="project-description">{project.description}</p>
            <details class="project-outline">
              <summary>Contribution & delivery</summary>
              <p>{project.contribution}</p>
              <p>
                <strong>Delivered:</strong> {project.outcome}
              </p>
            </details>
            <ul class="project-tags" aria-label="Technologies">
              {project.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
            {(project.demoUrl || project.codeUrl) && (
              <div class="project-links">
                {project.demoUrl && (
                  <a href={project.demoUrl}>
                    Open demo <span aria-hidden="true">↗</span>
                  </a>
                )}
                {project.codeUrl && (
                  <a href={project.codeUrl}>
                    Source code <span aria-hidden="true">↗</span>
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </section>
    <p class="projects-bottom-note">
      These are brief project outlines. Screenshots, public links and fuller
      case studies will be added as the portfolio develops.
    </p>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector<HTMLElement>('[data-projects-page]');
  if (page) {
    const controls = page.querySelector<HTMLElement>('[data-project-filters]')!;
    const buttons = [
      ...controls.querySelectorAll<HTMLButtonElement>('[data-project-filter]'),
    ];
    const cards = [
      ...page.querySelectorAll<HTMLElement>('[data-project-kind]'),
    ];
    const status = page.querySelector<HTMLElement>('[data-project-status]')!;
    controls.hidden = false;
    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        const kind = button.dataset.projectFilter;
        buttons.forEach((item) =>
          item.setAttribute('aria-pressed', String(item === button)),
        );
        cards.forEach((card) => {
          card.hidden = kind !== 'all' && card.dataset.projectKind !== kind;
        });
        status.textContent = `${cards.filter((card) => !card.hidden).length} ${status.dataset.countLabel}`;
      }),
    );
  }
</script>
