---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../lib/i18n';
import { href } from '../../lib/urls';
import { projectUrl, projectExternal } from '../../lib/project-content';
import { formatPostDate } from '../../lib/post-dates';
import { alamori } from '../../data/alamori';
import '../../styles/alamori.css';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = lang === 'tr';
const cover = alamori.covers[lang];
const preview =
  alamori.previews.find((item) => item.language === lang) ??
  alamori.previews[0];
const states: Record<string, string> = tr
  ? {
      writing: 'Yazım sürüyor',
      revising: 'Yeniden yazım',
      editing: 'Düzenleme',
      completed: 'Tamamlandı',
      paused: 'Ara verildi',
    }
  : {
      writing: 'Writing in progress',
      revising: 'Revising',
      editing: 'Editing',
      completed: 'Completed',
      paused: 'On hold',
    };
const roadmapStates: Record<string, string> = tr
  ? { done: 'Tamamlandı', current: 'Şu an', next: 'Sırada' }
  : { done: 'Done', current: 'Now', next: 'Next' };
const navigation = [
  ['story', tr ? 'Hikâye' : 'The story'],
  ['preview', tr ? 'Önizleme' : 'Preview'],
  ...(alamori.updates.length
    ? [['updates', tr ? 'Güncellemeler' : 'Updates']]
    : []),
  ...(alamori.roadmap.length
    ? [['roadmap', tr ? 'Yol haritası' : 'Roadmap']]
    : []),
  ...(alamori.articles.length
    ? [['journal', tr ? 'Yazım günlüğü' : 'Writing journal']]
    : []),
];
---

<BaseLayout
  title="Alamori"
  lang={lang}
  bodyClass="alamori-body"
  description={alamori.tagline[lang]}
>
  <div class="alamori-page">
    <header class="alamori-heading">
      <div>
        <p class="eyebrow">
          {tr ? 'Bir romanın yolculuğu' : 'The making of a novel'}
        </p>
        <h1>
          Alamori<span>.</span>
        </h1>
        <p class="alamori-subtitle">{alamori.subtitle[lang]}</p>
      </div>
      <p class="alamori-byline">
        {alamori.author}
        <span>{alamori.genres.map((genre) => genre[lang]).join(' · ')}</span>
      </p>
    </header>
    <div class="alamori-hero">
      <figure class="alamori-cover-stage">
        <img
          src={href(cover.src)}
          alt={cover.alt[lang]}
          width={cover.width}
          height={cover.height}
          fetchpriority="high"
        />
        <figcaption>
          {tr
            ? 'Hikâyeye açılan ilk kapı'
            : 'Your first doorway into the story'}
        </figcaption>
      </figure>
      <aside
        class="alamori-project-card"
        aria-label={
          tr ? 'Kitabın durumu ve önizleme' : 'Book status and preview'
        }
      >
        <p class={`alamori-status status-${alamori.status}`}>
          <span aria-hidden="true"></span>
          {states[alamori.status]}
        </p>
        <h2>{alamori.tagline[lang]}</h2>
        <p>{alamori.statusNote[lang]}</p>
        {preview && (
          <div class="alamori-hero-download">
            <a
              class="alamori-button"
              href={href(preview.src)}
              download={`Alamori-${preview.language}-preview.pdf`}
            >
              {tr
                ? `İlk ${preview.pages} sayfayı oku`
                : `Read the first ${preview.pages} pages`}{' '}
              <span aria-hidden="true">↓</span>
            </a>
            <span>
              {preview.language === 'tr' ? 'Türkçe' : 'English'} · PDF ·{' '}
              {tr ? 'Ücretsiz önizleme' : 'Free reading preview'}
            </span>
          </div>
        )}
        <div class="alamori-current">
          <span>{tr ? 'Yazım masasında' : 'On the writing desk'}</span>
          <p>{alamori.currentFocus[lang]}</p>
        </div>
        <p class="alamori-last-updated">
          {tr ? 'Son not' : 'Last update'}{' '}
          <time datetime={alamori.updatedAt}>
            {formatPostDate(alamori.updatedAt, lang)}
          </time>
        </p>
      </aside>
    </div>
    <nav
      class="alamori-navigation"
      aria-label={tr ? 'Bu sayfada' : 'On this page'}
    >
      {navigation.map(([id, label]) => (
        <a href={`#${id}`}>{label}</a>
      ))}
    </nav>
    <section id="story" class="alamori-section" aria-labelledby="story-heading">
      <div class="alamori-section-heading">
        <p class="eyebrow">01 / {tr ? 'Hikâye' : 'The story'}</p>
        <h2 id="story-heading">
          {tr ? 'Bir kitapla başlar.' : 'It begins with a book.'}
        </h2>
      </div>
      <div class="alamori-section-content alamori-story-copy">
        {alamori.synopsis.map((paragraph) => (
          <p>{paragraph[lang]}</p>
        ))}
        <dl class="alamori-facts">
          {alamori.facts?.map((fact) => (
            <div>
              <dt>{fact.label[lang]}</dt>
              <dd>{fact.value[lang]}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
    <section
      id="preview"
      class="alamori-section"
      aria-labelledby="preview-heading"
    >
      <div class="alamori-section-heading">
        <p class="eyebrow">02 / {tr ? 'İçeri bir bakış' : 'A look inside'}</p>
        <h2 id="preview-heading">
          {tr ? 'Önce birkaç sayfa.' : 'Start with a few pages.'}
        </h2>
        <p>
          {tr
            ? 'Anlatıcının sesiyle tanış, ilk sahnelerin peşinden git.'
            : 'Meet the narrator’s voice and follow the opening scenes.'}
        </p>
      </div>
      <div class="alamori-section-content">
        {alamori.previews.length ? (
          <div class="alamori-previews">
            {alamori.previews.map((item) => (
              <a
                class="alamori-preview-card"
                href={href(item.src)}
                download={`Alamori-${item.language}-preview.pdf`}
              >
                <span class="alamori-preview-icon" aria-hidden="true">
                  ↙
                </span>
                <div>
                  <h3>{item.language === 'tr' ? 'Türkçe' : 'English'}</h3>
                  <p>
                    {item.pages} {tr ? 'sayfa' : 'pages'} · PDF
                  </p>
                  <span>{tr ? 'Önizlemeyi indir' : 'Download preview'}</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <p>
            {tr
              ? 'Okuma önizlemesi hazırlanıyor. Yeni dosya burada yerini alacak.'
              : 'The reading preview is being prepared. The next file will appear here.'}
          </p>
        )}
        <p class="alamori-small-note">
          {tr
            ? 'Kapak ve açılış sayfaları önizlemeye dahildir. Metin yazım sürecinde değişebilir.'
            : 'The preview includes the cover and opening pages. The text may change during writing.'}
        </p>
      </div>
    </section>
    {!!alamori.updates.length && (
      <section
        id="updates"
        class="alamori-section"
        aria-labelledby="updates-heading"
      >
        <div class="alamori-section-heading">
          <p class="eyebrow">03 / {tr ? 'Gelişmeler' : 'Updates'}</p>
          <h2 id="updates-heading">{tr ? 'Yol boyunca.' : 'Along the way.'}</h2>
          <p>
            {tr
              ? 'Hikâyeden ve yazım masasından seçilmiş kısa notlar.'
              : 'Selected short notes from the story and the writing desk.'}
          </p>
        </div>
        <div class="alamori-section-content">
          <ol class="alamori-updates">
            {[...alamori.updates]
              .sort((a, b) => b.date.localeCompare(a.date))
              .map((update) => (
                <li>
                  <time datetime={update.date}>
                    {formatPostDate(update.date, lang)}
                  </time>
                  <h3>{update.title[lang]}</h3>
                  <p>{update.body[lang]}</p>
                </li>
              ))}
          </ol>
        </div>
      </section>
    )}
    {!!alamori.roadmap.length && (
      <section
        id="roadmap"
        class="alamori-section"
        aria-labelledby="roadmap-heading"
      >
        <div class="alamori-section-heading">
          <p class="eyebrow">04 / {tr ? 'Yol haritası' : 'Roadmap'}</p>
          <h2 id="roadmap-heading">
            {tr ? 'Nerede, nereye?' : 'Where it is headed.'}
          </h2>
          <p>
            {tr
              ? 'Yazımın bugünkü yönü. Bir takvim sözü değil, süreçten bir kesit.'
              : 'The current direction of the writing. A view of the process rather than a promised schedule.'}
          </p>
        </div>
        <div class="alamori-section-content">
          <ol class="alamori-roadmap">
            {alamori.roadmap.map((step) => (
              <li class={`roadmap-${step.state}`}>
                <span class="alamori-roadmap-dot" aria-hidden="true"></span>
                <div>
                  <span class="alamori-roadmap-state">
                    {roadmapStates[step.state]}
                  </span>
                  <h3>{step.title[lang]}</h3>
                  <p>{step.body[lang]}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}
    {!!alamori.articles.length && (
      <section
        id="journal"
        class="alamori-section"
        aria-labelledby="journal-heading"
      >
        <div class="alamori-section-heading">
          <p class="eyebrow">05 / {tr ? 'Yazım günlüğü' : 'Writing journal'}</p>
          <h2 id="journal-heading">
            {tr ? 'Sayfaların arkasında.' : 'Behind the pages.'}
          </h2>
          <p>
            {tr
              ? 'Nasıl yazıyorum, neyi yeniden düşünüyorum, neler oluyor?'
              : 'How I write, what I am reconsidering, and what is happening.'}
          </p>
        </div>
        <div class="alamori-section-content alamori-articles">
          {alamori.articles.map((article) => (
            <a href={projectUrl(article.url, lang)!}>
              <span>
                {tr ? 'Blog’dan' : 'From the blog'}{' '}
                <span aria-hidden="true">↗</span>
              </span>
              <h3>{article.title[lang]}</h3>
              <p>{article.summary[lang]}</p>
            </a>
          ))}
        </div>
      </section>
    )}
    <section
      id="feedback"
      class="alamori-reader-note"
      aria-labelledby="feedback-heading"
    >
      <div>
        <p class="eyebrow">{tr ? 'Okurdan yazara' : 'From reader to writer'}</p>
        <h2 id="feedback-heading">{alamori.feedback.title[lang]}</h2>
        <p>{alamori.feedback.description[lang]}</p>
      </div>
      <a
        class="alamori-button alamori-button-secondary"
        href={projectUrl(alamori.feedback.url, lang)!}
        target={
          projectExternal(projectUrl(alamori.feedback.url, lang)!)
            ? '_blank'
            : undefined
        }
        rel="noopener noreferrer"
      >
        {tr ? 'Bir okur notu gönder' : 'Send a reader note'}{' '}
        <span aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</BaseLayout>
