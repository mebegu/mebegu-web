---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabel, copy, localPath } from '../../lib/i18n';
import { formatPostDate, postCalendarDate } from '../../lib/post-dates';
interface Props {
  post: CollectionEntry<'writing'>;
}
const { post } = Astro.props;
const lang = post.data.lang;
const t = copy[lang];
const other = (
  await getCollection(
    'writing',
    ({ data }) =>
      !data.draft &&
      data.translationKey === post.data.translationKey &&
      data.lang !== lang,
  )
)[0];
const alternate = other ? `writing/${other.id}/` : 'writing/';
const { Content } = await render(post);
const date = postCalendarDate(post.data);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  lang={lang}
  alternatePath={alternate}
  hasTranslation={!!other}
>
  <article class="article">
    <a class="back-link" href={localPath('writing/', lang)}>
      ← {t.allWriting}
    </a>
    <header>
      <p class="eyebrow">
        {categoryLabel(post.data.category, lang)}{' '}
        <span aria-hidden="true">/</span>{' '}
        <time datetime={date}>{formatPostDate(date, lang)}</time>
      </p>
      <h1>{post.data.title}</h1>
      {!post.data.source && <p class="lead">{post.data.description}</p>}
      {post.data.source && (
        <p class="archive-note">
          {post.data.translatedFrom
            ? 'English translation'
            : lang === 'tr'
              ? 'Weebly arşivinden · Özgün metin'
              : 'From the Weebly archive · Original text'}
          {post.data.translatedFrom && other && (
            <>
              {' '}
              ·{' '}
              <a href={localPath(`writing/${other.id}/`, other.data.lang)}>
                Türkçe özgün metin
              </a>
            </>
          )}
        </p>
      )}
    </header>
    <div class="prose article-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .archive-note {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }
  .archive-note a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
