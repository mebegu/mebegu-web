---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Lang } from '../../lib/i18n';
import { href } from '../../lib/urls';
// Pinned upstream v2; generated src/data/cv.json is absent. See docs/CV.md.
// Public snapshot is generated upstream-first; the name mapping stays private.
import source from '../../data/cv.public.generated.json';
import '../../styles/professional.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const publicText = (value: string) => value.replace(/\*\*/g, '');
const plain = publicText;
const projectTitle = (value: string) =>
  publicText(value)
    .replace(/^Client [A-F] – /, '')
    .replace(/^Government – /, '');
const evidenceText = (value: string) =>
  publicText(value)
    .replace(/Client C/g, 'Landing Zone')
    .replace(/Client D/g, 'Device Platform');
const slug = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const sections = source.sections;
const experience = sections.Experience.filter((row) => typeof row !== 'string');
const experienceNote = sections.Experience.find(
  (row) => typeof row === 'string',
);
const projects = sections['Project Details'].flatMap((group) =>
  group.projects.map((project) => ({
    ...project,
    title: projectTitle(project.title),
    employer: group.company,
    id: slug(projectTitle(project.title)),
    art: /graph|analytics|feedback/i.test(project.title)
      ? 'data-notes-v1.webp'
      : 'infrastructure-v1.webp',
  })),
);
const findProject = (term: string) =>
  projects.find((project) => project.title.includes(term))!.id;
const projectRefs: Record<string, string> = {
  'IoT Platform': findProject('Next Generation'),
  'Battery Quality': findProject('Battery Quality'),
  'CRM KG': findProject('CRM Knowledge'),
  'Landing Zone': findProject('Landing Zone'),
  'Device Platform': findProject('Device Management'),
  'Sales Analytics': findProject('Sales Analytics'),
  'Customer Feedback': findProject('Customer Feedback'),
  SOC: findProject('Kubernetes SOC'),
};
const evidenceParts = (value: string) =>
  evidenceText(value)
    .split(' · ')
    .map((label) => ({
      label,
      project: Object.entries(projectRefs).find(([key]) =>
        label.startsWith(key),
      )?.[1],
    }));
const highlights = sections['Skill Highlights'].flatMap((line) => {
  const match = line.match(/^- \{(\w+)\} (.+?) :: (.+)$/);
  return match
    ? [
        {
          key: match[1],
          name: match[2],
          evidence: evidenceText(match[3]),
          parts: evidenceParts(match[3]),
        },
      ]
    : [];
});
const core = sections['Skill Highlights'].find((line) =>
  line.startsWith('Core tech:'),
)!;
const primaryKeys = ['cloud', 'signal', 'graph'];
const primaryHighlights = primaryKeys.map((key) =>
  highlights.find((item) => item.key === key)!,
);
const otherHighlights = highlights;
const stars = [
  {
    label: 'IoT Platform',
    id: projectRefs['IoT Platform'],
    related: 'cloud signal',
  },
  {
    label: 'Battery Quality',
    id: projectRefs['Battery Quality'],
    related: 'cloud',
  },
  { label: 'CRM KG', id: projectRefs['CRM KG'], related: 'cloud graph' },
];
const featuredProjects = stars.map((star) =>
  projects.find((project) => project.id === star.id)!,
);
const record = (line: string) =>
  line.replace(/^- /, '').split(' | ').map(plain);
const skillGroups = sections.Skills.map((line) => {
  const match = line.match(/^- \*\*(.+?):\*\* (.+)$/)!;
  return { label: match[1], items: match[2].split(', ') };
});
const logoFor = (name: string): string | undefined => {
  const value = name.toLowerCase();
  const matches: [RegExp, string][] = [
    [
      /^aws|^lambda$|^iot core$|^step functions$|^api gateway$|^ecs$|^glue$|^dynamodb$|^s3$|^rds$|^sqs$|^sns$|^kms$|^cloudwatch$|^x-ray$|^bedrock$|^vpc$|^transit gateway$|^route 53$|^organizations$|^control tower$|^iam identity center$/,
      'amazonwebservices',
    ],
    [/python|^pydantic$|^pytest$/, value === 'pytest' ? 'pytest' : 'python'],
    [/^typescript/, 'typescript'],
    [/^javascript$/, 'javascript'],
    [/^node\.js|^express$/, 'nodejs'],
    [/^docker$/, 'docker'],
    [/^kubernetes$/, 'kubernetes'],
    [/^terraform$/, 'terraform'],
    [/^neo4j|^cypher$/, 'neo4j'],
    [/^postgresql$/, 'postgresql'],
    [/^mongodb$/, 'mongodb'],
    [/^redis$/, 'redis'],
    [/^gitlab/, 'gitlab'],
    [/^github/, 'github'],
    [/^nestjs$/, 'nestjs'],
    [/^kafka$/, 'apachekafka'],
    [/^graphql$/, 'graphql'],
    [/^c#$/, 'csharp'],
    [/^unity/, 'unity'],
    [/^flask$/, 'flask'],
    [/^helm$/, 'helm'],
    [/^azure/, 'azure'],
    [/^jest$/, 'jest'],
  ];
  const icon = matches.find(([pattern]) => pattern.test(value))?.[1];
  return icon ? href(`art/professional/tech/${icon}.svg`) : undefined;
};
const projectMeta = (value: string) =>
  value.split(' · ').map((part) => {
    const match = part.match(/^\*\*(.+?)\*\*\s*(.*)$/);
    return match
      ? { label: match[1], value: publicText(match[2]) }
      : { label: '', value: plain(part) };
  });
---

<BaseLayout
  title="Professional"
  lang={lang}
  bodyClass="professional-body"
  description="Mehmet Berk Gürçay: cloud and backend engineering experience, skills and project details."
>
  <div class="professional-page" lang="en">
    <article id="cv" class="cv-document" aria-labelledby="cv-name" lang="en">
      <div class="professional-opening">
        <img
          class="opening-sky cv-screen-only"
          src={href('art/professional/observer-sky-v1.webp')}
          alt=""
          width="1800"
          height="819"
          fetchpriority="high"
        />
        <header class="cv-heading">
          <div class="cv-identity">
            <span
              class="identity-disc cv-screen-only"
              aria-hidden="true"
            ></span>
            <h1 id="cv-name">{source.name}</h1>
            <p class="cv-role">{source.role}</p>
          </div>
          <div class="cv-actions cv-screen-only">
            <a
              class="cv-download"
              href={href('cv/mehmet-berk-gurcay-cv.pdf')}
              download
            >
              Download PDF <span aria-hidden="true">↓</span>
            </a>
            <button class="cv-print" type="button" data-print-cv hidden>
              Print
            </button>
          </div>
          <div class="cv-contact">
            <details class="cv-contact-links">
              <summary>Contact</summary>
              <ul>
                <li>{source.contact[0]}</li>
                <li>
                  <a href={`mailto:${source.contact[1]}`}>
                    {source.contact[1]}
                  </a>
                </li>
                {source.contact.slice(2).map((contact) => (
                  <li>
                    <a href={`https://${contact}`}>{contact}</a>
                  </li>
                ))}
              </ul>
            </details>
          </div>
        </header>
        <section class="cv-summary" aria-labelledby="cv-summary-title">
          <details class="profile-disclosure">
            <summary>Profile</summary>
            <div class="profile-summary-panel">
              <h2 id="cv-summary-title">Summary</h2>
              <p>{publicText(sections.Summary.join(' '))}</p>
            </div>
          </details>
        </section>
        <nav
          class="skill-atlas cv-screen-only"
          id="skill-highlights"
          data-skill-atlas
          aria-label="Skill and project constellation"
        >
          <svg
            class="atlas-connections"
            viewBox="0 0 1000 500"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <g data-connections="cloud">
              <path d="M300 95 L480 100 L680 50 M300 95 L480 100 L540 245 L660 240 M300 95 L480 100 L540 245 L470 385 L690 415" />
            </g>
            <g data-connections="signal">
              <path d="M250 245 L540 245 L480 100 L680 50" />
            </g>
            <g data-connections="graph">
              <path d="M290 390 L470 385 L690 415" />
            </g>
            <g class="atlas-junctions">
              <circle cx="480" cy="100" r="3" />
              <circle cx="540" cy="245" r="3" />
              <circle cx="470" cy="385" r="3" />
            </g>
          </svg>
          <ol class="atlas-skills">
            {primaryHighlights.map((item, index) => (
              <li class={`atlas-skill atlas-skill-${index + 1}`}>
                <button
                  type="button"
                  class="atlas-skill-button"
                  data-skill={item.key}
                  aria-pressed="false"
                  aria-controls="atlas-projects"
                  disabled
                >
                  <span class="atlas-point" aria-hidden="true"></span>
                  <span>{item.name}</span>
                </button>
              </li>
            ))}
          </ol>
          <ul
            class="atlas-projects"
            id="atlas-projects"
            aria-label="Projects in the constellation"
          >
            {stars.map((star, index) => (
              <li
                class={`atlas-project atlas-project-${index + 1}`}
                data-related={star.related}
              >
                <a
                  href={`#project-${star.id}`}
                  data-atlas-project={star.id}
                  aria-controls={`feature-${star.id}`}
                  aria-current={index === 0 ? 'true' : undefined}
                >
                  <span class="atlas-point" aria-hidden="true"></span>
                  <span class="atlas-project-label">{star.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <aside
        class="featured-project cv-screen-only"
        aria-label="Selected project"
        data-featured-project
      >
        {featuredProjects.map((project, index) => (
          <div
            class="feature-panel"
            id={`feature-${project.id}`}
            data-feature-panel={project.id}
            hidden={index !== 0}
          >
            <div class="feature-copy">
              <p class="feature-kicker">Selected Project</p>
              <h3>{project.title}</h3>
              <p class="feature-context">{publicText(project.context)}</p>
              <a
                class="feature-link"
                href={`#project-${project.id}`}
                data-project-link
              >
                View project <span aria-hidden="true">↗</span>
              </a>
            </div>
            <figure class="feature-art">
              <img
                src={href(`art/professional/${project.art}`)}
                alt=""
                width="1000"
                height="563"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
              <figcaption>Concept illustration</figcaption>
            </figure>
          </div>
        ))}
      </aside>

      <section
        class="skill-highlights"
        id="all-skill-highlights"
        aria-labelledby="cv-highlights-title"
      >
        <header class="atlas-heading">
          <h2 id="cv-highlights-title">Skill Highlights</h2>
        </header>
        <details class="other-highlights" data-print-expand>
          <summary>
            All skill highlights{' '}
            <span class="detail-symbol" aria-hidden="true">
              +
            </span>
          </summary>
          <ul>
            {otherHighlights.map((item) => (
              <li>
                <h3>{item.name}</h3>
                <p>
                  {item.parts.map((part, index) => (
                    <>
                      {index > 0 && ' · '}
                      {part.project ? (
                        <a href={`#project-${part.project}`} data-project-link>
                          {part.label}
                        </a>
                      ) : (
                        part.label
                      )}
                    </>
                  ))}
                </p>
              </li>
            ))}
          </ul>
        </details>
        <p class="cv-core">{core}</p>
      </section>

      <section
        class="cv-section cv-experience"
        id="experience"
        aria-labelledby="cv-experience-title"
      >
        <header class="cv-section-heading">
          <h2 id="cv-experience-title">Experience</h2>
          <a class="cv-screen-only" href="#project-details">
            Project details <span aria-hidden="true">↗</span>
          </a>
        </header>
        <div class="experience-list">
          {experience.map((entry) => (
            <article class="experience-entry">
              <header>
                <div>
                  <h3>{entry.role}</h3>
                  <p class="experience-employer">
                    {entry.company} · {entry.city}
                  </p>
                </div>
                <p class="experience-period">{entry.period}</p>
              </header>
              <ul>
                {entry.bullets.map((bullet) => (
                  <li>{publicText(bullet)}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
        {typeof experienceNote === 'string' && (
          <p class="cv-source-pointer">
            {publicText(experienceNote.replace(/^Details: /, ''))}
          </p>
        )}
      </section>

      <section class="cv-section" id="skills" aria-labelledby="cv-skills-title">
        <h2 id="cv-skills-title">Skills</h2>
        <dl class="tech-groups">
          {skillGroups.map((group) => (
            <div>
              <dt>{group.label}:</dt>
              <dd>
                {group.items.map((tech, index) => (
                  <>
                    {index > 0 && <span class="tech-separator">, </span>}
                    <span class="tech-item">
                      {logoFor(tech) && (
                        <span class="tech-logo">
                          <img
                            src={logoFor(tech)}
                            alt=""
                            width="20"
                            height="20"
                            loading="lazy"
                          />
                        </span>
                      )}
                      {tech}
                    </span>
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section
        class="cv-section"
        id="education"
        aria-labelledby="cv-education-title"
      >
        <h2 id="cv-education-title">Education</h2>
        <ul class="cv-records">
          {sections.Education.map((line) => {
            const cells = record(line);
            return (
              <li>
                {cells.length > 1 ? (
                  <>
                    <div>
                      <h3>{cells[0]}</h3>
                      <p>{cells[1]}</p>
                    </div>
                    <span class="record-year">{cells[2]}</span>
                  </>
                ) : (
                  <p class="record-note">{cells[0]}</p>
                )}
              </li>
            );
          })}
        </ul>
      </section>
      <section
        class="cv-section"
        id="certifications"
        aria-labelledby="cv-certifications-title"
      >
        <h2 id="cv-certifications-title">Certifications</h2>
        <ul class="cv-certificates">
          {sections.Certifications.map((line) => {
            const cells = record(line);
            return (
              <li>
                <span class="certificate-logo">
                  <img
                    src={logoFor(cells[0])}
                    alt=""
                    width="36"
                    height="36"
                    loading="lazy"
                  />
                </span>
                <h3>{cells[0]}</h3>
                <span class="record-year">{cells[1]}</span>
              </li>
            );
          })}
        </ul>
      </section>
      <section
        class="cv-section"
        id="languages"
        aria-labelledby="cv-languages-title"
      >
        <h2 id="cv-languages-title">Languages</h2>
        <dl class="cv-languages">
          {sections.Languages.map((line) => {
            const cells = record(line);
            return (
              <div>
                <dt>{cells[0]}</dt>
                <dd>{cells[1]}</dd>
              </div>
            );
          })}
        </dl>
      </section>
      <section
        class="cv-section"
        id="teaching"
        aria-labelledby="cv-teaching-title"
      >
        <h2 id="cv-teaching-title">Teaching &amp; Community</h2>
        <p>{publicText(sections['Teaching & Community'].join(' '))}</p>
      </section>
      <section
        class="cv-section"
        id="interests"
        aria-labelledby="cv-interests-title"
      >
        <h2 id="cv-interests-title">Interests</h2>
        <p>{sections.Interests.join(' ')}</p>
      </section>
    </article>

    <section
      class="professional-projects cv-screen-only"
      id="project-details"
      aria-labelledby="project-details-title"
      lang="en"
    >
      <header class="projects-heading">
        <div>
          <p class="cv-kicker">Selected work</p>
          <h2 id="project-details-title">Project Details</h2>
        </div>
        <button type="button" class="cv-expand" data-expand-projects hidden>
          Expand all
        </button>
      </header>
      <p class="project-publication-note">
        Client names are anonymized. Illustrations are concept art.
      </p>
      <div class="project-list">
        {projects.map((project, index) => (
          <details class="project" id={`project-${project.id}`} data-project>
            <summary>
              <span class="project-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="project-overview">
                <span class="project-employer">{project.employer}</span>
                <h3>{project.title}</h3>
                <span class="project-context">
                  {publicText(project.context)}
                </span>
              </span>
              <span class="detail-symbol" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="project-body">
              <div class="project-main">
                <dl class="project-meta">
                  {projectMeta(project.meta).map((part) => (
                    <div>
                      <dt>{part.label}</dt>
                      <dd>{part.value}</dd>
                    </div>
                  ))}
                </dl>
                <h4>Contributions</h4>
                <ul>
                  {project.bullets.map((bullet) => (
                    <li>{publicText(bullet)}</li>
                  ))}
                </ul>
                <h4>Technologies</h4>
                <ul class="project-tech">
                  {project.stack.split(', ').map((tech) => (
                    <li>
                      {logoFor(tech) && (
                        <span class="tech-logo">
                          <img
                            src={logoFor(tech)}
                            alt=""
                            width="20"
                            height="20"
                            loading="lazy"
                          />
                        </span>
                      )}
                      {tech}
                    </li>
                  ))}
                </ul>
              </div>
              <figure class="project-art">
                <img
                  src={href(`art/professional/${project.art}`)}
                  alt=""
                  width="1000"
                  height="563"
                  loading="lazy"
                />
                <figcaption>Concept illustration</figcaption>
              </figure>
              <a class="project-return" href="#skill-highlights">
                Back to skill highlights <span aria-hidden="true">↑</span>
              </a>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-print-cv]')
    .forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', () => window.print());
    });
  const selectProject = (id: string) => {
    document
      .querySelectorAll<HTMLElement>('[data-feature-panel]')
      .forEach((panel) => {
        panel.hidden = panel.dataset.featurePanel !== id;
      });
    document
      .querySelectorAll<HTMLAnchorElement>('[data-atlas-project]')
      .forEach((link) => {
        if (link.dataset.atlasProject === id)
          link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
  };
  document
    .querySelectorAll<HTMLAnchorElement>('[data-atlas-project]')
    .forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        selectProject(link.dataset.atlasProject!);
        if (matchMedia('(max-width: 700px)').matches) {
          document
            .querySelector('[data-featured-project]')
            ?.scrollIntoView({ block: 'nearest', behavior: 'instant' });
        }
      });
    });
  document
    .querySelectorAll<HTMLElement>('[data-skill-atlas]')
    .forEach((atlas) => {
      const buttons = atlas.querySelectorAll<HTMLButtonElement>('[data-skill]');
      const drawConnections = () => {
        const box = atlas.getBoundingClientRect();
        if (!box.width || !box.height) return;
        const point = (element: Element) => {
          const rect = element.getBoundingClientRect();
          return `${((rect.left + rect.width / 2 - box.left) / box.width) * 1000} ${((rect.top + rect.height / 2 - box.top) / box.height) * 500}`;
        };
        buttons.forEach((button) => {
          const start = button.querySelector('.atlas-point');
          const path = atlas.querySelector(
            `[data-connections="${button.dataset.skill}"] path`,
          );
          if (!start || !path) return;
          const targets = atlas.querySelectorAll(
            `[data-related~="${button.dataset.skill}"] .atlas-point`,
          );
          const junctions = ['480 100', '540 245', '470 385'];
          const routes: Record<string, number[][]> = {
            cloud: [[0], [0, 1], [0, 1, 2]],
            signal: [[1, 0]],
            graph: [[2]],
          };
          path.setAttribute(
            'd',
            Array.from(targets)
              .map((target, index) => {
                const via = (routes[button.dataset.skill!][index] || [])
                  .map((junction) => ` L${junctions[junction]}`)
                  .join('');
                return `M${point(start)}${via} L${point(target)}`;
              })
              .join(' '),
          );
        });
      };
      new ResizeObserver(drawConnections).observe(atlas);
      void document.fonts.ready.then(drawConnections);
      buttons.forEach((button) => {
        button.disabled = false;
        button.addEventListener('click', () => {
          const selected =
            button.getAttribute('aria-pressed') !== 'true'
              ? button.dataset.skill
              : undefined;
          buttons.forEach((item) =>
            item.setAttribute(
              'aria-pressed',
              String(item.dataset.skill === selected),
            ),
          );
          atlas.dataset.selected = selected || '';
          if (selected) {
            const first = atlas.querySelector<HTMLAnchorElement>(
              `[data-related~="${selected}"] [data-atlas-project]`,
            );
            if (first?.dataset.atlasProject)
              selectProject(first.dataset.atlasProject);
          }
          atlas
            .querySelectorAll<HTMLElement>('[data-related]')
            .forEach((item) =>
              item.classList.toggle(
                'is-related',
                Boolean(
                  selected &&
                  item.dataset.related?.split(' ').includes(selected),
                ),
              ),
            );
        });
      });
    });
  const openProject = () => {
    const target = document.getElementById(
      decodeURIComponent(location.hash.slice(1)),
    );
    if (
      target instanceof HTMLDetailsElement &&
      target.hasAttribute('data-project')
    )
      target.open = true;
  };
  document
    .querySelectorAll<HTMLAnchorElement>('[data-project-link]')
    .forEach((link) =>
      link.addEventListener('click', () => {
        const target = document.getElementById(link.hash.slice(1));
        if (target instanceof HTMLDetailsElement) {
          target.open = true;
          requestAnimationFrame(() =>
            target.querySelector('summary')?.focus({ preventScroll: true }),
          );
        }
      }),
    );
  window.addEventListener('hashchange', openProject);
  openProject();
  document
    .querySelectorAll<HTMLButtonElement>('[data-expand-projects]')
    .forEach((button) => {
      const projects =
        document.querySelectorAll<HTMLDetailsElement>('[data-project]');
      const update = () =>
        (button.textContent = Array.from(projects).every(
          (project) => project.open,
        )
          ? 'Collapse all'
          : 'Expand all');
      button.hidden = false;
      button.addEventListener('click', () => {
        const expand = !Array.from(projects).every((project) => project.open);
        projects.forEach((project) => (project.open = expand));
        update();
      });
      projects.forEach((project) => project.addEventListener('toggle', update));
    });
  const printStates = new Map<HTMLDetailsElement, boolean>();
  window.addEventListener('beforeprint', () =>
    document
      .querySelectorAll<HTMLDetailsElement>('#cv details')
      .forEach((details) => {
        if (!printStates.has(details)) printStates.set(details, details.open);
        details.open = true;
      }),
  );
  window.addEventListener('afterprint', () => {
    printStates.forEach((open, details) => (details.open = open));
    printStates.clear();
  });
</script>
