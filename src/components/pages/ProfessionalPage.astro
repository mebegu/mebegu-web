---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Lang } from '../../lib/i18n';
import { resume } from '../../data/resume';
import '../../styles/professional.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<BaseLayout
  title="Professional"
  lang={lang}
  bodyClass="professional-body"
  description="Mehmet Berk Gürçay — software and cloud engineering experience, CV and selected work."
>
  <div class="professional-page" lang="en">
    <div class="cv-controls cv-screen-only">
      <div class="cv-controls-navigation">
        <p class="eyebrow">Résumé & portfolio</p>
        <nav aria-label="On this page">
          <a href="#cv">CV</a>
          <a href="#portfolio">Selected work</a>
        </nav>
      </div>
      <button type="button" class="cv-print-button" data-print-cv hidden>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M7 8V3h10v5M7 17H4V9h16v8h-3M7 14h10v7H7zM17 11h1" />
        </svg>
        Print CV / save PDF
      </button>
    </div>
    <p class="cv-print-help cv-screen-only">
      Print → Save as PDF. Only the CV section is printed.
    </p>
    <article id="cv" class="cv-document" aria-labelledby="cv-name">
      <header class="cv-heading">
        <h1 id="cv-name">{resume.name}</h1>
        <p class="cv-role">{resume.role}</p>
        <ul class="cv-contact" aria-label="Contact">
          <li>{resume.location}</li>
          <li>
            <a href={`mailto:${resume.email}`}>{resume.email}</a>
          </li>
          <li>
            <a href={resume.github}>github.com/mebegu</a>
          </li>
        </ul>
      </header>
      <section class="cv-section" aria-labelledby="cv-profile">
        <h2 id="cv-profile">Profile</h2>
        <p>{resume.summary}</p>
      </section>
      <section class="cv-section" aria-labelledby="cv-experience">
        <h2 id="cv-experience">Experience</h2>
        {resume.experience.map((entry) => (
          <div class="cv-entry">
            <div class="cv-entry-heading">
              <div>
                <h3>{entry.role}</h3>
                <p class="cv-organization">
                  {entry.organization} · {entry.location}
                </p>
              </div>
              <p class="cv-period">{entry.period}</p>
            </div>
            <ul class="cv-highlights">
              {entry.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </section>
      <section class="cv-section" aria-labelledby="cv-skills">
        <h2 id="cv-skills">Technical skills</h2>
        <dl class="cv-skills">
          {resume.skills.map((group) => (
            <div>
              <dt>{group.label}</dt>
              <dd>{group.skills.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section class="cv-section" aria-labelledby="cv-education">
        <h2 id="cv-education">Education</h2>
        {resume.education.map((entry) => (
          <div class="cv-entry">
            <div class="cv-entry-heading">
              <div>
                <h3>{entry.degree}</h3>
                <p class="cv-organization">{entry.institution}</p>
              </div>
              <p class="cv-period">{entry.period}</p>
            </div>
          </div>
        ))}
      </section>
      <section class="cv-section" aria-labelledby="cv-languages">
        <h2 id="cv-languages">Languages</h2>
        <p>{resume.languages.join(' · ')}</p>
      </section>
    </article>
    <section
      id="portfolio"
      class="professional-portfolio cv-screen-only"
      aria-labelledby="portfolio-heading"
    >
      <p class="eyebrow">Portfolio</p>
      <h2 id="portfolio-heading">
        Selected work<span class="accent">.</span>
      </h2>
      <p class="portfolio-intro">
        Cloud infrastructure, data platforms and application development. A
        first outline of the problems, my contributions and the work delivered.
      </p>
      {resume.work.map((work) => (
        <article class="work-sample">
          <p class="work-draft-label">
            {work.organization}
            {work.period && ` · ${work.period}`}
          </p>
          <h3>{work.title}</h3>
          <dl class="work-story">
            <div>
              <dt>Context</dt>
              <dd>{work.context}</dd>
            </div>
            <div>
              <dt>My contribution</dt>
              <dd>{work.contribution}</dd>
            </div>
            <div>
              <dt>Delivered</dt>
              <dd>{work.outcome}</dd>
            </div>
          </dl>
          <p class="work-technologies">{work.technologies.join(' · ')}</p>
        </article>
      ))}
      <p class="portfolio-note">
        Selected work is excluded from the CV printout. Screenshots and fuller
        case studies will be added over time.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-print-cv]')
    .forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', () => window.print());
    });
</script>
