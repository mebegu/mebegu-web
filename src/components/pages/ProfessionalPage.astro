---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Lang } from '../../lib/i18n';
import { href } from '../../lib/urls';
// Pinned upstream v2; generated src/data/cv.json is absent. See docs/CV.md.
// Public snapshot is generated upstream-first; the name mapping stays private.
import source from '../../data/cv.public.generated.json';
import '../../styles/professional.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const publicText = (value: string) => value.replace(/\*\*/g, '');
const plain = publicText;
const projectTitle = (value: string) =>
  publicText(value)
    .replace(/^Client [A-F] – /, '')
    .replace(/^Government – /, '');
const evidenceText = (value: string) =>
  publicText(value)
    .replace(/Client C/g, 'Landing Zone')
    .replace(/Client D/g, 'Device Platform');
const slug = (value: string) =>
  value
    .toLowerCase()
    .normalize('NFKD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
const sections = source.sections;
const experience = sections.Experience.filter((row) => typeof row !== 'string');
const experienceNote = sections.Experience.find(
  (row) => typeof row === 'string',
);
const projects = sections['Project Details'].flatMap((group) =>
  group.projects.map((project) => ({
    ...project,
    title: projectTitle(project.title),
    employer: group.company,
    id: slug(projectTitle(project.title)),
    art: /graph|analytics|feedback/i.test(project.title)
      ? 'data-notes-v1.webp'
      : 'infrastructure-v1.webp',
  })),
);
const findProject = (term: string) =>
  projects.find((project) => project.title.includes(term))!.id;
const projectRefs: Record<string, string> = {
  'IoT Platform': findProject('Next Generation'),
  'Battery Quality': findProject('Battery Quality'),
  'CRM KG': findProject('CRM Knowledge'),
  'Landing Zone': findProject('Landing Zone'),
  'Device Platform': findProject('Device Management'),
  'Sales Analytics': findProject('Sales Analytics'),
  'Customer Feedback': findProject('Customer Feedback'),
  SOC: findProject('Kubernetes SOC'),
};
const evidenceParts = (value: string) =>
  evidenceText(value)
    .split(' · ')
    .map((label) => ({
      label,
      project: Object.entries(projectRefs).find(([key]) =>
        label.startsWith(key),
      )?.[1],
    }));
const highlights = sections['Skill Highlights'].flatMap((line) => {
  const match = line.match(/^- \{(\w+)\} (.+?) :: (.+)$/);
  return match
    ? [
        {
          key: match[1],
          name: match[2],
          evidence: evidenceText(match[3]),
          parts: evidenceParts(match[3]),
        },
      ]
    : [];
});
const core = sections['Skill Highlights'].find((line) =>
  line.startsWith('Core tech:'),
)!;
const otherHighlights = highlights;
const starPositions = [
  [42, 23],
  [67, 31],
  [79, 49],
  [55, 12],
  [29, 20],
  [20, 56],
  [50, 75],
  [79, 71],
  [34, 87],
  [64, 57],
  [13, 32],
  [10, 78],
];
const careerStars = [
  ...projects.map((project, index) => ({
    id: project.id,
    title: project.title,
    subtitle: project.employer,
    context: publicText(project.context),
    meta: publicText(project.meta),
    href: `#project-${project.id}`,
    x: starPositions[index][0],
    y: starPositions[index][1],
    label:
      index === 1
        ? highlights.find((item) => item.key === 'cloud')!.name
        : index === 5
          ? highlights.find((item) => item.key === 'signal')!.name
          : index === 6
            ? highlights.find((item) => item.key === 'graph')!.name
            : project.title,
    pinned: [1, 5, 6].includes(index),
    kind: 'project',
  })),
  ...experience.map((entry, index) => ({
    id: `role-${index}`,
    title: entry.role,
    subtitle: `${entry.company} · ${entry.city}`,
    context: publicText(entry.bullets[0]),
    meta: entry.period,
    href: '#experience',
    x: [34, 49, 68][index],
    y: [44, 46, 89][index],
    label: entry.company,
    pinned: false,
    kind: 'experience',
  })),
];
let skySeed = 173;
const skyRandom = () => {
  skySeed = (skySeed * 16807) % 2147483647;
  return skySeed / 2147483647;
};
const clusterDust = Array.from({ length: 96 }, () => {
  const radius = Math.sqrt(-2 * Math.log(Math.max(0.001, skyRandom())));
  const angle = skyRandom() * Math.PI * 2;
  return {
    x: Math.min(97, Math.max(3, 51 + Math.cos(angle) * radius * 21)),
    y: Math.min(97, Math.max(3, 49 + Math.sin(angle) * radius * 23)),
    size: 0.6 + skyRandom() * 1.3,
    opacity: 0.15 + skyRandom() * 0.6,
  };
});
const record = (line: string) =>
  line.replace(/^- /, '').split(' | ').map(plain);
const skillGroups = sections.Skills.map((line) => {
  const match = line.match(/^- \*\*(.+?):\*\* (.+)$/)!;
  return { label: match[1], items: match[2].split(', ') };
});
const logoFor = (name: string): string | undefined => {
  const value = name.toLowerCase();
  const matches: [RegExp, string][] = [
    [
      /^aws|^lambda$|^iot core$|^step functions$|^api gateway$|^ecs$|^glue$|^dynamodb$|^s3$|^rds$|^sqs$|^sns$|^kms$|^cloudwatch$|^x-ray$|^bedrock$|^vpc$|^transit gateway$|^route 53$|^organizations$|^control tower$|^iam identity center$/,
      'amazonwebservices',
    ],
    [/python|^pydantic$|^pytest$/, value === 'pytest' ? 'pytest' : 'python'],
    [/^typescript/, 'typescript'],
    [/^javascript$/, 'javascript'],
    [/^node\.js|^express$/, 'nodejs'],
    [/^docker$/, 'docker'],
    [/^kubernetes$/, 'kubernetes'],
    [/^terraform$/, 'terraform'],
    [/^neo4j|^cypher$/, 'neo4j'],
    [/^postgresql$/, 'postgresql'],
    [/^mongodb$/, 'mongodb'],
    [/^redis$/, 'redis'],
    [/^gitlab/, 'gitlab'],
    [/^github/, 'github'],
    [/^nestjs$/, 'nestjs'],
    [/^kafka$/, 'apachekafka'],
    [/^graphql$/, 'graphql'],
    [/^c#$/, 'csharp'],
    [/^unity/, 'unity'],
    [/^flask$/, 'flask'],
    [/^helm$/, 'helm'],
    [/^azure/, 'azure'],
    [/^jest$/, 'jest'],
  ];
  const icon = matches.find(([pattern]) => pattern.test(value))?.[1];
  return icon ? href(`art/professional/tech/${icon}.svg`) : undefined;
};
const projectMeta = (value: string) =>
  value.split(' · ').map((part) => {
    const match = part.match(/^\*\*(.+?)\*\*\s*(.*)$/);
    return match
      ? { label: match[1], value: publicText(match[2]) }
      : { label: '', value: plain(part) };
  });
---

<BaseLayout
  title="Professional"
  lang={lang}
  bodyClass="professional-body"
  description="Mehmet Berk Gürçay: cloud and backend engineering experience, skills and project details."
>
  <div class="professional-page" lang="en">
    <article id="cv" class="cv-document" aria-labelledby="cv-name" lang="en">
      <div class="professional-opening">
        <img
          class="opening-sky cv-screen-only"
          src={href('art/professional/quiet-sky-v2.webp')}
          alt=""
          width="1774"
          height="887"
          fetchpriority="high"
        />
        <header class="cv-heading">
          <div class="cv-identity">
            <h1 id="cv-name">{source.name}</h1>
            <p class="cv-role">{source.role}</p>
          </div>
          <div class="cv-actions cv-screen-only">
            <a
              class="cv-download"
              href={href('cv/mehmet-berk-gurcay-cv.pdf')}
              download
            >
              Download PDF <span aria-hidden="true">↓</span>
            </a>
            <button class="cv-print" type="button" data-print-cv hidden>
              Print
            </button>
          </div>
          <div class="cv-contact">
            <details class="cv-contact-links" name="professional-intro">
              <summary>Contact</summary>
              <ul>
                <li>{source.contact[0]}</li>
                <li>
                  <a href={`mailto:${source.contact[1]}`}>
                    {source.contact[1]}
                  </a>
                </li>
                {source.contact.slice(2).map((contact) => (
                  <li>
                    <a href={`https://${contact}`}>{contact}</a>
                  </li>
                ))}
              </ul>
            </details>
          </div>
        </header>
        <section class="cv-summary" aria-labelledby="cv-summary-title">
          <details class="profile-disclosure" name="professional-intro">
            <summary aria-label="Profile">
              <span class="profile-star-dot" aria-hidden="true"></span>
              <span class="career-star-label">Profile</span>
            </summary>
            <div class="profile-summary-panel">
              <h2 id="cv-summary-title">Summary</h2>
              <p>{publicText(sections.Summary.join(' '))}</p>
            </div>
          </details>
        </section>
        <nav
          class="skill-atlas career-cluster cv-screen-only"
          id="skill-highlights"
          data-skill-atlas
          aria-label="Career stars"
        >
          <p class="cluster-help" id="cluster-help">
            Select a star to read about a project or role.
          </p>
          <div class="cluster-dust" aria-hidden="true">
            {clusterDust.map((star) => (
              <span
                style={`--x:${star.x}%;--y:${star.y}%;--size:${star.size}px;--opacity:${star.opacity}`}
              ></span>
            ))}
          </div>
          <ol class="career-stars">
            {careerStars.map((star) => (
              <li style={`--x:${star.x}%;--y:${star.y}%`}>
                <a
                  class:list={[
                    'career-star',
                    { 'is-pinned': star.pinned, 'label-left': star.x > 50 },
                    `star-${star.kind}`,
                  ]}
                  href={star.href}
                  data-career-star={star.id}
                  aria-label={`${star.label}: ${star.title}, ${star.subtitle}`}
                  aria-controls={`feature-${star.id}`}
                  aria-expanded="false"
                  aria-describedby="cluster-help"
                >
                  <span class="career-star-dot" aria-hidden="true"></span>
                  <span class="career-star-label">{star.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <aside
          class="career-readout cv-screen-only"
          aria-label="Career details"
          data-featured-project
          hidden
        >
          {careerStars.map((star) => (
            <div id={`feature-${star.id}`} data-feature-panel={star.id} hidden>
              <p class="career-subtitle">{star.subtitle}</p>
              <h3 tabindex="-1">{star.title}</h3>
              <p class="career-meta">{star.meta}</p>
              <p class="career-context">{star.context}</p>
              <a class="career-more" href={star.href} data-project-link>
                {star.kind === 'project' ? 'Project details' : 'Experience'}{' '}
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          ))}
          <button
            class="career-close"
            type="button"
            data-close-career
            aria-label="Close career details"
          >
            Close
          </button>
        </aside>
      </div>

      <section
        class="skill-highlights"
        id="all-skill-highlights"
        aria-labelledby="cv-highlights-title"
      >
        <header class="atlas-heading">
          <h2 id="cv-highlights-title">Skill Highlights</h2>
        </header>
        <details class="other-highlights" data-print-expand>
          <summary>
            All skill highlights{' '}
            <span class="detail-symbol" aria-hidden="true">
              +
            </span>
          </summary>
          <ul>
            {otherHighlights.map((item) => (
              <li>
                <h3>{item.name}</h3>
                <p>
                  {item.parts.map((part, index) => (
                    <>
                      {index > 0 && ' · '}
                      {part.project ? (
                        <a href={`#project-${part.project}`} data-project-link>
                          {part.label}
                        </a>
                      ) : (
                        part.label
                      )}
                    </>
                  ))}
                </p>
              </li>
            ))}
          </ul>
        </details>
        <p class="cv-core">{core}</p>
      </section>

      <section
        class="cv-section cv-experience"
        id="experience"
        aria-labelledby="cv-experience-title"
      >
        <header class="cv-section-heading">
          <h2 id="cv-experience-title">Experience</h2>
          <a class="cv-screen-only" href="#project-details">
            Project details <span aria-hidden="true">↗</span>
          </a>
        </header>
        <div class="experience-list">
          {experience.map((entry) => (
            <article class="experience-entry">
              <header>
                <div>
                  <h3>{entry.role}</h3>
                  <p class="experience-employer">
                    {entry.company} · {entry.city}
                  </p>
                </div>
                <p class="experience-period">{entry.period}</p>
              </header>
              <ul>
                {entry.bullets.map((bullet) => (
                  <li>{publicText(bullet)}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
        {typeof experienceNote === 'string' && (
          <p class="cv-source-pointer">
            {publicText(experienceNote.replace(/^Details: /, ''))}
          </p>
        )}
      </section>

      <section class="cv-section" id="skills" aria-labelledby="cv-skills-title">
        <h2 id="cv-skills-title">Skills</h2>
        <dl class="tech-groups">
          {skillGroups.map((group) => (
            <div>
              <dt>{group.label}:</dt>
              <dd>
                {group.items.map((tech, index) => (
                  <>
                    {index > 0 && <span class="tech-separator">, </span>}
                    <span class="tech-item">
                      {logoFor(tech) && (
                        <span class="tech-logo">
                          <img
                            src={logoFor(tech)}
                            alt=""
                            width="20"
                            height="20"
                            loading="lazy"
                          />
                        </span>
                      )}
                      {tech}
                    </span>
                  </>
                ))}
              </dd>
            </div>
          ))}
        </dl>
      </section>

      <section
        class="cv-section"
        id="education"
        aria-labelledby="cv-education-title"
      >
        <h2 id="cv-education-title">Education</h2>
        <ul class="cv-records">
          {sections.Education.map((line) => {
            const cells = record(line);
            return (
              <li>
                {cells.length > 1 ? (
                  <>
                    <div>
                      <h3>{cells[0]}</h3>
                      <p>{cells[1]}</p>
                    </div>
                    <span class="record-year">{cells[2]}</span>
                  </>
                ) : (
                  <p class="record-note">{cells[0]}</p>
                )}
              </li>
            );
          })}
        </ul>
      </section>
      <section
        class="cv-section"
        id="certifications"
        aria-labelledby="cv-certifications-title"
      >
        <h2 id="cv-certifications-title">Certifications</h2>
        <ul class="cv-certificates">
          {sections.Certifications.map((line) => {
            const cells = record(line);
            return (
              <li>
                <span class="certificate-logo">
                  <img
                    src={logoFor(cells[0])}
                    alt=""
                    width="36"
                    height="36"
                    loading="lazy"
                  />
                </span>
                <h3>{cells[0]}</h3>
                <span class="record-year">{cells[1]}</span>
              </li>
            );
          })}
        </ul>
      </section>
      <section
        class="cv-section"
        id="languages"
        aria-labelledby="cv-languages-title"
      >
        <h2 id="cv-languages-title">Languages</h2>
        <dl class="cv-languages">
          {sections.Languages.map((line) => {
            const cells = record(line);
            return (
              <div>
                <dt>{cells[0]}</dt>
                <dd>{cells[1]}</dd>
              </div>
            );
          })}
        </dl>
      </section>
      <section
        class="cv-section"
        id="teaching"
        aria-labelledby="cv-teaching-title"
      >
        <h2 id="cv-teaching-title">Teaching &amp; Community</h2>
        <p>{publicText(sections['Teaching & Community'].join(' '))}</p>
      </section>
      <section
        class="cv-section"
        id="interests"
        aria-labelledby="cv-interests-title"
      >
        <h2 id="cv-interests-title">Interests</h2>
        <p>{sections.Interests.join(' ')}</p>
      </section>
    </article>

    <section
      class="professional-projects cv-screen-only"
      id="project-details"
      aria-labelledby="project-details-title"
      lang="en"
    >
      <header class="projects-heading">
        <div>
          <p class="cv-kicker">Selected work</p>
          <h2 id="project-details-title">Project Details</h2>
        </div>
        <button type="button" class="cv-expand" data-expand-projects hidden>
          Expand all
        </button>
      </header>
      <p class="project-publication-note">
        Client names are anonymized. Illustrations are concept art.
      </p>
      <div class="project-list">
        {projects.map((project, index) => (
          <details class="project" id={`project-${project.id}`} data-project>
            <summary>
              <span class="project-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="project-overview">
                <span class="project-employer">{project.employer}</span>
                <h3>{project.title}</h3>
                <span class="project-context">
                  {publicText(project.context)}
                </span>
              </span>
              <span class="detail-symbol" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="project-body">
              <div class="project-main">
                <dl class="project-meta">
                  {projectMeta(project.meta).map((part) => (
                    <div>
                      <dt>{part.label}</dt>
                      <dd>{part.value}</dd>
                    </div>
                  ))}
                </dl>
                <h4>Contributions</h4>
                <ul>
                  {project.bullets.map((bullet) => (
                    <li>{publicText(bullet)}</li>
                  ))}
                </ul>
                <h4>Technologies</h4>
                <ul class="project-tech">
                  {project.stack.split(', ').map((tech) => (
                    <li>
                      {logoFor(tech) && (
                        <span class="tech-logo">
                          <img
                            src={logoFor(tech)}
                            alt=""
                            width="20"
                            height="20"
                            loading="lazy"
                          />
                        </span>
                      )}
                      {tech}
                    </li>
                  ))}
                </ul>
              </div>
              <figure class="project-art">
                <img
                  src={href(`art/professional/${project.art}`)}
                  alt=""
                  width="1000"
                  height="563"
                  loading="lazy"
                />
                <figcaption>Concept illustration</figcaption>
              </figure>
              <a class="project-return" href="#skill-highlights">
                Back to skill highlights <span aria-hidden="true">↑</span>
              </a>
            </div>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const introPanels = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(
      '[name="professional-intro"]',
    ),
  );
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const openPanel = introPanels.find((panel) => panel.open);
    if (!openPanel) return;
    openPanel.open = false;
    openPanel.querySelector('summary')?.focus({ preventScroll: true });
    event.preventDefault();
  });
  document.addEventListener('pointerdown', (event) => {
    if (
      event.target instanceof Node &&
      introPanels.some((panel) => panel.contains(event.target as Node))
    )
      return;
    introPanels.forEach((panel) => (panel.open = false));
  });
  document
    .querySelectorAll<HTMLButtonElement>('[data-print-cv]')
    .forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', () => window.print());
    });
  const careerReadout = document.querySelector<HTMLElement>(
    '[data-featured-project]',
  );
  const careerLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-career-star]'),
  );
  let activeStar: HTMLAnchorElement | undefined;
  const closeCareer = (restoreFocus = false) => {
    if (careerReadout) careerReadout.hidden = true;
    careerLinks.forEach((link) => link.setAttribute('aria-expanded', 'false'));
    if (restoreFocus) activeStar?.focus({ preventScroll: true });
  };
  careerLinks.forEach((link) =>
    link.addEventListener('click', (event) => {
      if (!careerReadout) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
        return;
      event.preventDefault();
      const panel = document.getElementById(
        `feature-${link.dataset.careerStar}`,
      );
      if (!panel) return;
      introPanels.forEach((item) => (item.open = false));
      activeStar = link;
      careerReadout
        .querySelectorAll<HTMLElement>('[data-feature-panel]')
        .forEach((item) => (item.hidden = item !== panel));
      careerLinks.forEach((item) =>
        item.setAttribute('aria-expanded', String(item === link)),
      );
      careerReadout.hidden = false;
      panel.querySelector('h3')?.focus({ preventScroll: true });
    }),
  );
  document
    .querySelector('[data-close-career]')
    ?.addEventListener('click', () => closeCareer(true));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && careerReadout && !careerReadout.hidden) {
      closeCareer(true);
      event.preventDefault();
    }
  });
  document.addEventListener('pointerdown', (event) => {
    if (!(event.target instanceof Node)) return;
    if (
      careerReadout?.contains(event.target) ||
      document.querySelector('.career-cluster')?.contains(event.target)
    )
      return;
    closeCareer();
  });
  careerReadout
    ?.querySelectorAll('a')
    .forEach((link) => link.addEventListener('click', () => closeCareer()));
  const openProject = () => {
    const target = document.getElementById(
      decodeURIComponent(location.hash.slice(1)),
    );
    if (
      target instanceof HTMLDetailsElement &&
      target.hasAttribute('data-project')
    )
      target.open = true;
  };
  document
    .querySelectorAll<HTMLAnchorElement>('[data-project-link]')
    .forEach((link) =>
      link.addEventListener('click', () => {
        const target = document.getElementById(link.hash.slice(1));
        if (target instanceof HTMLDetailsElement) {
          target.open = true;
          requestAnimationFrame(() =>
            target.querySelector('summary')?.focus({ preventScroll: true }),
          );
        } else if (target instanceof HTMLElement) {
          const heading = target.querySelector<HTMLElement>('h2');
          if (heading) {
            heading.tabIndex = -1;
            requestAnimationFrame(() => heading.focus({ preventScroll: true }));
          }
        }
      }),
    );
  window.addEventListener('hashchange', openProject);
  openProject();
  document
    .querySelectorAll<HTMLButtonElement>('[data-expand-projects]')
    .forEach((button) => {
      const projects =
        document.querySelectorAll<HTMLDetailsElement>('[data-project]');
      const update = () =>
        (button.textContent = Array.from(projects).every(
          (project) => project.open,
        )
          ? 'Collapse all'
          : 'Expand all');
      button.hidden = false;
      button.addEventListener('click', () => {
        const expand = !Array.from(projects).every((project) => project.open);
        projects.forEach((project) => (project.open = expand));
        update();
      });
      projects.forEach((project) => project.addEventListener('toggle', update));
    });
  const printStates = new Map<HTMLDetailsElement, boolean>();
  const printNames = new Map<HTMLDetailsElement, string>();
  window.addEventListener('beforeprint', () => {
    const details =
      document.querySelectorAll<HTMLDetailsElement>('#cv details');
    details.forEach((item) => {
      if (!printStates.has(item)) printStates.set(item, item.open);
      const name = item.getAttribute('name');
      if (name !== null) {
        printNames.set(item, name);
        item.removeAttribute('name');
      }
    });
    details.forEach((item) => (item.open = true));
  });
  window.addEventListener('afterprint', () => {
    printStates.forEach((open, details) => (details.open = open));
    printNames.forEach((name, details) => details.setAttribute('name', name));
    printStates.clear();
    printNames.clear();
  });
</script>
