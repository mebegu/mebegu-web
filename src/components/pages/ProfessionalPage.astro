---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { type Lang } from '../../lib/i18n';
import { resume } from '../../data/resume';
import '../../styles/professional.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = lang === 'tr';
const draft = resume.status === 'draft';
const text = tr
  ? {
      title: 'Profesyonel',
      intro: 'Özgeçmiş & portföy',
      print: 'CV’yi yazdır / PDF',
      printHint:
        'PDF için: Yazdır → PDF olarak kaydet. Yalnızca CV bölümü yazdırılır.',
      draft: 'CV taslağı',
      draftNote:
        'Mesleki geçmiş ve iletişim bilgileri henüz tamamlanmadı. Köşeli parantezli alanlar doldurulacaktır.',
      profile: 'Profil',
      profileHint:
        '[Odak alanın, ilgili deneyimin ve öne çıkan katkın hakkında 2–3 kısa cümle.]',
      experience: 'İş deneyimi',
      role: '[Pozisyon / unvan]',
      company: '[Şirket adı]',
      dates: '[AA/YYYY – AA/YYYY]',
      achievement:
        '[Geliştirdiğin çözüm, kullandığın yöntem veya teknoloji ve ortaya çıkan somut sonuç.]',
      contribution:
        '[Üstlendiğin sorumluluk ve ekip ya da ürün üzerindeki katkın. Varsa doğrulanabilir bir ölçüm ekle.]',
      skills: 'Teknik yetkinlikler',
      skillLabels: ['Programlama', 'Teknolojiler', 'Araçlar & yöntemler'],
      skillHints: [
        '[Kullandığın programlama dilleri]',
        '[Çalıştığın framework ve platformlar]',
        '[Veritabanları, test, sürüm kontrolü ve diğer araçlar]',
      ],
      education: 'Eğitim',
      degree: '[Diploma / bölüm]',
      institution: '[Üniversite / kurum]',
      languages: 'Diller',
      languageHint: '[Dil — seviye]',
      location: '[Şehir, ülke]',
      email: '[Profesyonel e-posta]',
      contact: 'İletişim',
      portfolio: 'Seçilmiş çalışmalar',
      portfolioIntro:
        'Projelerin arkasındaki problem, üstlendiğim rol ve ortaya çıkan sonuç.',
      portfolioDraft: 'Çalışma örneği taslağı',
      project: '[Proje / ürün adı]',
      context: 'Problem',
      contextHint: '[Hangi ihtiyacı karşılıyordu? Kimin için geliştirildi?]',
      myRole: 'Katkım',
      myRoleHint:
        '[Hangi kısmını üstlendin? Hangi kararları aldın ve neleri geliştirdin?]',
      result: 'Sonuç',
      resultHint:
        '[Ne değişti? Paylaşılabilir çıktı, kazanım veya ölçülebilir etki.]',
      view: 'Çalışmayı görüntüle',
      note: 'Portföy web sayfasında kalır; CV çıktısına dahil edilmez.',
    }
  : {
      title: 'Professional',
      intro: 'Résumé & portfolio',
      print: 'Print CV / save PDF',
      printHint:
        'For a PDF: Print → Save as PDF. Only the CV section is printed.',
      draft: 'CV draft',
      draftNote:
        'Career history and contact details are not complete yet. Bracketed fields are placeholders.',
      profile: 'Profile',
      profileHint:
        '[Two or three short sentences about your focus, relevant experience and strongest contribution.]',
      experience: 'Experience',
      role: '[Position / job title]',
      company: '[Company name]',
      dates: '[MM/YYYY – MM/YYYY]',
      achievement:
        '[The solution you built, the method or technology you used, and the concrete outcome.]',
      contribution:
        '[Your responsibility and contribution to the team or product. Add a verifiable measure if available.]',
      skills: 'Technical skills',
      skillLabels: ['Programming', 'Technologies', 'Tools & practices'],
      skillHints: [
        '[Programming languages you use]',
        '[Frameworks and platforms you work with]',
        '[Databases, testing, version control and other tools]',
      ],
      education: 'Education',
      degree: '[Degree / field of study]',
      institution: '[University / institution]',
      languages: 'Languages',
      languageHint: '[Language — proficiency]',
      location: '[City, country]',
      email: '[Professional email]',
      contact: 'Contact',
      portfolio: 'Selected work',
      portfolioIntro:
        'The problem behind each project, my contribution, and the outcome.',
      portfolioDraft: 'Work sample draft',
      project: '[Project / product name]',
      context: 'Problem',
      contextHint: '[What need did it address? Who was it built for?]',
      myRole: 'My contribution',
      myRoleHint:
        '[What did you own? Which decisions did you make and what did you build?]',
      result: 'Outcome',
      resultHint:
        '[What changed? A shareable deliverable, improvement or measurable impact.]',
      view: 'View work',
      note: 'The portfolio stays on the website and is excluded from the CV printout.',
    };
const contacts = [
  ...(resume.email
    ? [{ label: resume.email, href: `mailto:${resume.email}` }]
    : []),
  ...(resume.phone
    ? [
        {
          label: resume.phone,
          href: `tel:${resume.phone.replace(/[^+\d]/g, '')}`,
        },
      ]
    : []),
  ...[resume.linkedin, resume.github, resume.website]
    .filter((url): url is string => Boolean(url))
    .map((url) => ({
      label: url.replace(/^https?:\/\//, '').replace(/\/$/, ''),
      href: url,
    })),
];
---

<BaseLayout title={text.title} lang={lang} bodyClass="professional-body">
  <div class="professional-page">
    <div class="cv-controls cv-screen-only">
      <div class="cv-controls-navigation">
        <p class="eyebrow">{text.intro}</p>
        <nav aria-label={tr ? 'Bu sayfada' : 'On this page'}>
          <a href="#cv">CV</a>
          <a href="#portfolio">{tr ? 'Portföy' : 'Portfolio'}</a>
        </nav>
      </div>
      <button type="button" class="cv-print-button" data-print-cv hidden>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M7 8V3h10v5M7 17H4V9h16v8h-3M7 14h10v7H7zM17 11h1" />
        </svg>
        {text.print}
      </button>
    </div>
    <p class="cv-print-help cv-screen-only">{text.printHint}</p>
    <article id="cv" class="cv-document" aria-labelledby="cv-name">
      <header class="cv-heading">
        <h1 id="cv-name">{resume.name}</h1>
        <p class="cv-role">{resume.role[lang]}</p>
        <ul class="cv-contact" aria-label={text.contact}>
          {resume.location && <li>{resume.location[lang]}</li>}
          {contacts.map((contact) => (
            <li>
              <a href={contact.href}>{contact.label}</a>
            </li>
          ))}
          {draft && !resume.location && (
            <li class="cv-placeholder">{text.location}</li>
          )}
          {draft && !resume.email && (
            <li class="cv-placeholder">{text.email}</li>
          )}
        </ul>
      </header>
      {draft && (
        <aside class="cv-draft-note">
          <strong>{text.draft}</strong>
          <span>{text.draftNote}</span>
        </aside>
      )}
      {(resume.summary || draft) && (
        <section class="cv-section" aria-labelledby="cv-profile">
          <h2 id="cv-profile">{text.profile}</h2>
          <p class:list={{ 'cv-placeholder': !resume.summary }}>
            {resume.summary?.[lang] ?? text.profileHint}
          </p>
        </section>
      )}
      {(resume.experience.length > 0 || draft) && (
        <section class="cv-section" aria-labelledby="cv-experience">
          <h2 id="cv-experience">{text.experience}</h2>
          {resume.experience.map((entry) => (
            <div class="cv-entry">
              <div class="cv-entry-heading">
                <div>
                  <h3>{entry.role[lang]}</h3>
                  <p class="cv-organization">
                    {entry.organization}
                    {entry.location && ` · ${entry.location[lang]}`}
                  </p>
                </div>
                <p class="cv-period">{entry.period[lang]}</p>
              </div>
              {entry.highlights.length > 0 && (
                <ul class="cv-highlights">
                  {entry.highlights.map((item) => (
                    <li>{item[lang]}</li>
                  ))}
                </ul>
              )}
            </div>
          ))}
          {draft && !resume.experience.length && (
            <div class="cv-entry cv-placeholder">
              <div class="cv-entry-heading">
                <div>
                  <h3>{text.role}</h3>
                  <p class="cv-organization">{text.company}</p>
                </div>
                <p class="cv-period">{text.dates}</p>
              </div>
              <ul class="cv-highlights">
                <li>{text.achievement}</li>
                <li>{text.contribution}</li>
              </ul>
            </div>
          )}
        </section>
      )}
      {(resume.skills.length > 0 || draft) && (
        <section class="cv-section" aria-labelledby="cv-skills">
          <h2 id="cv-skills">{text.skills}</h2>
          <dl class="cv-skills">
            {resume.skills.map((group) => (
              <div>
                <dt>{group.label[lang]}</dt>
                <dd>{group.skills.join(', ')}</dd>
              </div>
            ))}
            {draft &&
              !resume.skills.length &&
              text.skillLabels.map((label, index) => (
                <div>
                  <dt>{label}</dt>
                  <dd class="cv-placeholder">{text.skillHints[index]}</dd>
                </div>
              ))}
          </dl>
        </section>
      )}
      {(resume.education.length > 0 || draft) && (
        <section class="cv-section" aria-labelledby="cv-education">
          <h2 id="cv-education">{text.education}</h2>
          {resume.education.map((entry) => (
            <div class="cv-entry">
              <div class="cv-entry-heading">
                <div>
                  <h3>{entry.degree[lang]}</h3>
                  <p class="cv-organization">{entry.institution}</p>
                </div>
                <p class="cv-period">{entry.period[lang]}</p>
              </div>
              {entry.detail && <p>{entry.detail[lang]}</p>}
            </div>
          ))}
          {draft && !resume.education.length && (
            <div class="cv-entry cv-placeholder">
              <div class="cv-entry-heading">
                <div>
                  <h3>{text.degree}</h3>
                  <p class="cv-organization">{text.institution}</p>
                </div>
                <p class="cv-period">{text.dates}</p>
              </div>
            </div>
          )}
        </section>
      )}
      {(resume.languages.length > 0 || draft) && (
        <section class="cv-section" aria-labelledby="cv-languages">
          <h2 id="cv-languages">{text.languages}</h2>
          <p class:list={{ 'cv-placeholder': !resume.languages.length }}>
            {resume.languages.length
              ? resume.languages.map((language) => language[lang]).join(' · ')
              : text.languageHint}
          </p>
        </section>
      )}
    </article>
    <section
      id="portfolio"
      class="professional-portfolio cv-screen-only"
      aria-labelledby="portfolio-heading"
    >
      <p class="eyebrow">{tr ? 'Portföy' : 'Portfolio'}</p>
      <h2 id="portfolio-heading">
        {text.portfolio}
        <span class="accent">.</span>
      </h2>
      <p class="portfolio-intro">{text.portfolioIntro}</p>
      {resume.work.map((work) => (
        <article class="work-sample">
          <h3>{work.title[lang]}</h3>
          <dl class="work-story">
            <div>
              <dt>{text.context}</dt>
              <dd>{work.context[lang]}</dd>
            </div>
            <div>
              <dt>{text.myRole}</dt>
              <dd>{work.contribution[lang]}</dd>
            </div>
            <div>
              <dt>{text.result}</dt>
              <dd>{work.outcome[lang]}</dd>
            </div>
          </dl>
          {work.technologies.length > 0 && (
            <p class="work-technologies">{work.technologies.join(' · ')}</p>
          )}
          {work.url && (
            <a class="text-link" href={work.url}>
              {text.view} <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
      {!resume.work.length && (
        <article class="work-sample work-sample-draft">
          <p class="work-draft-label">{text.portfolioDraft}</p>
          <h3>{text.project}</h3>
          <dl class="work-story">
            <div>
              <dt>{text.context}</dt>
              <dd>{text.contextHint}</dd>
            </div>
            <div>
              <dt>{text.myRole}</dt>
              <dd>{text.myRoleHint}</dd>
            </div>
            <div>
              <dt>{text.result}</dt>
              <dd>{text.resultHint}</dd>
            </div>
          </dl>
        </article>
      )}
      <p class="portfolio-note">{text.note}</p>
    </section>
  </div>
</BaseLayout>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('[data-print-cv]')
    .forEach((button) => {
      button.hidden = false;
      button.addEventListener('click', () => window.print());
    });
</script>
