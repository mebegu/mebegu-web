---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localPath, type Lang } from '../../lib/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = lang === 'tr';
const seeds = [
  {
    id: 'glass',
    title: 'Google Glass',
    url: localPath(`writing/weebly-google-glass${tr ? '' : '-en'}/`, lang),
    note: tr
      ? 'Bir zamanların gelecek fikrine bugünden bakmak.'
      : 'Revisiting an earlier idea of the future.',
    tags: tr ? 'teknoloji, tasarım' : 'technology, design',
    read: false,
  },
  {
    id: 'traffic',
    title: 'İstanbul Traffic for Dummies',
    url: localPath(
      `writing/weebly-stanbul-traffic-for-dummies${tr ? '' : '-en'}/`,
      lang,
    ),
    note: tr
      ? 'Gündelik bir deneyimi anlatmanın farklı bir yolu.'
      : 'A different way to tell an everyday story.',
    tags: tr ? 'şehir, deneme' : 'city, essay',
    read: false,
  },
  {
    id: 'beginning',
    title: tr ? 'Bir başlangıç' : 'A place to begin',
    url: localPath(
      `writing/${tr ? 'bir-baslangic' : 'a-place-to-begin'}/`,
      lang,
    ),
    note: tr
      ? 'Üretmek, yazmak ve fikirlere yer açmak üzerine.'
      : 'Making room for projects, writing and ideas.',
    tags: tr ? 'kişisel' : 'personal',
    read: true,
  },
];
---

<BaseLayout
  title={tr ? 'Cep Arşivi' : 'Pocket Archive'}
  lang={lang}
  description={
    tr
      ? 'Okumak istediğin bağlantıları bir notla sakla, etiketle ve yeniden bul.'
      : 'Save links with a note, give them a tag, and find them again.'
  }
>
  <div
    class="archive-page"
    data-pocket-archive
    data-lang={lang}
    data-seeds={JSON.stringify(seeds)}
  >
    <header class="archive-heading">
      <div>
        <p class="archive-eyebrow">
          {tr ? 'Küçük bir okuma arşivi' : 'A small reading archive'}
        </p>
        <h1>
          {tr ? 'Cep Arşivi' : 'Pocket Archive'}
          <span>.</span>
        </h1>
        <p>
          {tr
            ? 'Sekmeleri açık tutma. Fikri yanında tut.'
            : 'Keep the idea, not another open tab.'}
        </p>
      </div>
      <a href={`${localPath('projects/', lang)}#project-pocket-archive`}>
        {tr ? 'Proje hakkında' : 'About this project'} ↗
      </a>
    </header>
    <noscript>
      <p>
        {tr
          ? 'Arşivi kullanmak için JavaScript gerekli. Proje hakkında bilgiye yukarıdaki bağlantıdan ulaşabilirsin.'
          : 'Enable JavaScript to use the archive. Follow the link above to read about the project.'}
      </p>
    </noscript>
    <div class="archive-workspace">
      <form class="archive-compose" data-archive-form>
        <h2>{tr ? 'Bir bağlantı bırak' : 'Save something good'}</h2>
        <label>
          {tr ? 'Başlık' : 'Title'}
          <input
            name="title"
            required
            maxlength="160"
            placeholder={
              tr
                ? 'Dönüp bakmak istediğim bir şey'
                : 'Something worth coming back to'
            }
          />
        </label>
        <label>
          {tr ? 'Bağlantı' : 'Link'}
          <input name="url" type="url" required placeholder="https://…" />
        </label>
        <label>
          {tr ? 'Neden sakladın?' : 'Why keep it?'}
          <textarea
            name="note"
            rows="3"
            maxlength="1000"
            placeholder={
              tr
                ? 'Gelecekteki kendine kısa bir not…'
                : 'A short note to your future self…'
            }
          ></textarea>
        </label>
        <label>
          {tr ? 'Etiketler' : 'Tags'}
          <input
            name="tags"
            maxlength="160"
            placeholder={
              tr
                ? 'tasarım, yazılım, sonra oku'
                : 'design, software, read later'
            }
          />
        </label>
        <button class="archive-save" type="submit">
          {tr ? 'Arşive ekle' : 'Save to archive'}{' '}
          <span aria-hidden="true">↗</span>
        </button>
        <p class="archive-storage-note">
          {tr
            ? 'Kayıtlar bu tarayıcıda saklanır. Hesap açmadan, sunucuya göndermeden.'
            : 'Saved in this browser. No account, no upload.'}
        </p>
      </form>
      <section
        class="archive-collection"
        aria-label={tr ? 'Kaydettiğin bağlantılar' : 'Your saved links'}
      >
        <div class="archive-collection-heading">
          <h2>{tr ? 'Dönüp bakılacaklar' : 'Worth a second look'}</h2>
          <button class="archive-export" type="button" data-archive-export>
            {tr ? 'JSON indir' : 'Export JSON'} ↓
          </button>
        </div>
        <label class="archive-search">
          <span class="sr-only">{tr ? 'Arşivde ara' : 'Search archive'}</span>
          <input
            type="search"
            data-archive-search
            placeholder={
              tr
                ? 'Başlık, not veya etiket ara…'
                : 'Search titles, notes or tags…'
            }
          />
        </label>
        <div
          class="archive-filters"
          role="group"
          aria-label={tr ? 'Okuma durumu' : 'Reading status'}
        >
          <button type="button" data-archive-filter="all" aria-pressed="true">
            {tr ? 'Tümü' : 'All'}
          </button>
          <button
            type="button"
            data-archive-filter="unread"
            aria-pressed="false"
          >
            {tr ? 'Sırada' : 'To read'}
          </button>
          <button type="button" data-archive-filter="read" aria-pressed="false">
            {tr ? 'Okuduklarım' : 'Read'}
          </button>
          <span data-archive-count></span>
        </div>
        <div class="archive-cards" data-archive-cards></div>
        <p class="archive-empty" data-archive-empty hidden>
          {tr
            ? 'Burada henüz bir şey yok. Bir bağlantı ekle veya aramanı değiştir.'
            : 'Nothing here yet. Save a link or try a different search.'}
        </p>
        <p
          class="archive-message"
          data-archive-message
          role="status"
          aria-live="polite"
        ></p>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { initPocketArchive } from '../../lib/pocket-archive';
  document
    .querySelectorAll<HTMLElement>('[data-pocket-archive]')
    .forEach(initPocketArchive);
</script>

<style>
  .archive-page {
    padding: 48px 0;
    color: #ecebe7;
  }
  .archive-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    padding-bottom: 32px;
    border-bottom: 1px solid #a7b9c129;
  }
  .archive-eyebrow {
    color: #dfbc8e;
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.14em;
  }
  h1 {
    margin: 12px 0 16px;
    font-size: clamp(40px, 6vw, 72px);
    letter-spacing: -0.065em;
    line-height: 1.05;
  }
  h1 span {
    color: #dfbc8e;
  }
  .archive-heading p:last-child {
    color: #aeb8c0;
    margin: 0;
  }
  .archive-heading a {
    color: #dfbc8e;
    font-size: 13px;
    white-space: nowrap;
  }
  .archive-workspace {
    display: grid;
    grid-template-columns: minmax(0, 310px) minmax(0, 1fr);
    gap: 40px;
    padding-top: 32px;
    align-items: start;
  }
  h2 {
    font-size: 19px;
    font-weight: 500;
    margin: 0 0 24px;
    letter-spacing: -0.025em;
  }
  .archive-compose {
    padding: 24px;
    border: 1px solid #a7b9c129;
    border-radius: 8px;
    background: #1b222a;
  }
  label {
    display: block;
    font-size: 12px;
    color: #c0c9d0;
    margin-bottom: 18px;
  }
  input,
  textarea {
    display: block;
    width: 100%;
    margin-top: 8px;
    box-sizing: border-box;
    padding: 12px;
    border: 1px solid #a7b9c13d;
    border-radius: 4px;
    background: #141a20;
    color: #ecebe7;
    font: inherit;
    font-size: 14px;
  }
  textarea {
    resize: vertical;
  }
  input:focus-visible,
  textarea:focus-visible,
  button:focus-visible,
  a:focus-visible {
    outline: 2px solid #dfbc8e;
    outline-offset: 3px;
  }
  button {
    font: inherit;
    cursor: pointer;
  }
  .archive-save {
    display: flex;
    justify-content: space-between;
    width: 100%;
    min-height: 44px;
    padding: 12px 16px;
    border: 0;
    border-radius: 4px;
    background: #dfbc8e;
    color: #182028;
    font-size: 13px;
  }
  .archive-storage-note {
    color: #aeb8c0;
    font-size: 11px;
    line-height: 1.7;
    margin: 18px 0 0;
  }
  .archive-collection {
    min-width: 0;
  }
  .archive-collection-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .archive-export {
    padding: 8px 0;
    min-height: 44px;
    border: 0;
    background: none;
    color: #dfbc8e;
    font-size: 12px;
  }
  .archive-search input {
    margin: 0;
    background: #1b222a;
  }
  .archive-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 20px;
  }
  .archive-filters button {
    border: 1px solid #a7b9c129;
    background: transparent;
    border-radius: 30px;
    color: #aeb8c0;
    padding: 8px 14px;
    min-height: 44px;
    font-size: 12px;
  }
  .archive-filters button[aria-pressed='true'] {
    color: #dfbc8e;
    border-color: #dfbc8e70;
    background: #dfbc8e0a;
  }
  .archive-filters span {
    margin-left: auto;
    color: #aeb8c0;
    font-size: 11px;
  }
  .archive-message,
  .archive-empty {
    font-size: 13px;
    line-height: 1.7;
    color: #aeb8c0;
  }
  .archive-cards :global(.archive-card) {
    padding: 22px 0;
    border-top: 1px solid #a7b9c129;
  }
  .archive-cards :global(.archive-card-topline) {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #aeb8c0;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }
  .archive-cards :global(.archive-card-read) {
    color: #a9d0bf;
  }
  .archive-cards :global(h3) {
    margin: 12px 0 8px;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .archive-cards :global(h3 a) {
    color: #ecebe7;
    overflow-wrap: anywhere;
  }
  .archive-cards :global(h3 a:hover) {
    color: #dfbc8e;
  }
  .archive-cards :global(p) {
    color: #aeb8c0;
    font-size: 13px;
    line-height: 1.8;
    margin: 0 0 12px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .archive-cards :global(.archive-card-tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
  .archive-cards :global(.archive-card-tags span) {
    color: #a6c6bf;
    border: 1px solid #a6c6bf30;
    border-radius: 3px;
    padding: 3px 7px;
    font-size: 10px;
  }
  .archive-cards :global(.archive-card-actions) {
    display: flex;
    gap: 18px;
    margin-top: 16px;
  }
  .archive-cards :global(.archive-card-actions button) {
    background: none;
    border: 0;
    padding: 4px 0;
    min-height: 44px;
    color: #dfbc8e;
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }
  .archive-cards :global(.archive-card-actions button:last-child) {
    color: #9ba7af;
  }
  @media (max-width: 760px) {
    .archive-page {
      padding-top: 32px;
    }
    .archive-heading {
      display: block;
    }
    .archive-heading a {
      display: inline-block;
      margin-top: 20px;
    }
    .archive-workspace {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .archive-compose {
      padding: 20px;
    }
    input,
    textarea {
      font-size: 16px;
    }
  }
</style>
