---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogCover from '../blog/CatalogCover.astro';
import BlogBannerImage from '../blog/BlogBannerImage.astro';
import {
  getBlogCatalog,
  catalogShelves,
  featuredPostIds,
} from '../../data/blog-catalog';
import type { Lang } from '../../lib/i18n';
import { formatPostDate } from '../../lib/post-dates';
import '../../styles/blog-catalog.css';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = lang === 'tr';
const catalogPosts = await getBlogCatalog(lang);
const years = catalogPosts.map((post) => post.date.slice(0, 4)).sort();
const yearRange =
  years[0] === years.at(-1) ? years[0] : `${years[0]}–${years.at(-1)}`;
const shelves = catalogShelves.filter((shelf) =>
  catalogPosts.some((post) => post.shelf === shelf.id),
);
const featured = featuredPostIds
  .map((id) => catalogPosts.find((post) => post.key === id))
  .filter((post): post is (typeof catalogPosts)[number] => Boolean(post));
const newTab = tr ? 'Yeni sekmede açılır' : 'Opens in a new tab';
const open = tr ? 'Yazıyı aç' : 'Read post';
---

<BaseLayout
  title="Blog"
  lang={lang}
  bodyClass="blog-body"
  description={
    tr
      ? 'Yazılım, yol notları, hikâyeler ve fikirler. Kişisel yazı kütüphanesi.'
      : 'Code, travel notes, stories and ideas. A personal writing library.'
  }
>
  <div class="blog-catalog" data-blog-catalog>
    <section
      class="catalog-featured"
      aria-label={tr ? 'Öne çıkan yazılar' : 'Featured posts'}
      aria-roledescription={tr ? 'Slayt gösterisi' : 'Carousel'}
    >
      <header class="catalog-heading">
        <h1>
          Blog<span class="accent">.</span>
        </h1>
        <p>
          {catalogPosts.length} {tr ? 'yazı' : 'posts'}
          {yearRange && <> · {yearRange}</>}
        </p>
      </header>
      <div class="featured-track" data-featured-track>
        {featured.map((post, index) => (
          <div
            class:list={[
              'catalog-slide',
              `tone-${post.tone}`,
              { 'is-active': index === 0 },
            ]}
            data-slide
            data-story={post.key}
            role="group"
            aria-roledescription={tr ? 'Slayt' : 'Slide'}
            aria-label={`${index + 1} / ${featured.length}`}
          >
            <div class="feature-art" aria-hidden="true">
              {post.banner ? (
                <BlogBannerImage image={post.banner} priority={index === 0} />
              ) : (
                <CatalogCover cover={post.cover} priority={index === 0} />
              )}
            </div>
            <div class="feature-copy" data-feature-copy>
              <p class="feature-kicker">
                {tr ? 'Öne çıkan' : 'Featured'}{' '}
                <span aria-hidden="true">/</span>{' '}
                {
                  catalogShelves.find((shelf) => shelf.id === post.shelf)
                    ?.title[lang]
                }
              </p>
              <h2 lang={post.lang}>{post.title}</h2>
              <p class="feature-publication">
                <time datetime={post.date}>
                  {formatPostDate(post.date, lang)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{post.lang === 'tr' ? 'Türkçe' : 'English'}</span>
              </p>
              <p class="feature-description">{post.description}</p>
              <a
                class="feature-open"
                href={post.path}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${post.title} — ${newTab}`}
              >
                {open} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="feature-controls" data-feature-controls hidden>
        <div
          class="feature-dots"
          role="group"
          aria-label={tr ? 'Öne çıkan yazıyı seç' : 'Choose a featured post'}
        >
          {featured.map((post, index) => (
            <button
              type="button"
              data-slide-to={index}
              aria-label={`${index + 1}: ${post.title}`}
              aria-current={index === 0 ? 'true' : undefined}
            >
              <span></span>
            </button>
          ))}
        </div>
        <div class="feature-buttons">
          <button
            type="button"
            class="feature-pause"
            data-slide-pause
            aria-pressed="false"
            aria-label={
              tr ? 'Otomatik geçişi duraklat' : 'Pause automatic slides'
            }
            data-pause-label={
              tr ? 'Otomatik geçişi duraklat' : 'Pause automatic slides'
            }
            data-play-label={
              tr ? 'Otomatik geçişi başlat' : 'Play automatic slides'
            }
          >
            <svg class="pause-icon" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M7 5v10M13 5v10" />
            </svg>
            <svg class="play-icon" viewBox="0 0 20 20" aria-hidden="true">
              <path d="m7 5 7 5-7 5Z" />
            </svg>
          </button>
          <button
            type="button"
            data-slide-prev
            aria-label={tr ? 'Önceki yazı' : 'Previous post'}
          >
            ←
          </button>
          <button
            type="button"
            data-slide-next
            aria-label={tr ? 'Sonraki yazı' : 'Next post'}
          >
            →
          </button>
        </div>
      </div>
      <p
        class="sr-only"
        data-slide-status
        aria-live="polite"
        aria-atomic="true"
      ></p>
    </section>

    <div class="catalog-library">
      <nav
        class="catalog-jumps"
        aria-label={tr ? 'Yazı kategorileri' : 'Post categories'}
      >
        {shelves.map((shelf) => (
          <a href={`#shelf-${shelf.id}`}>{shelf.title[lang]}</a>
        ))}
      </nav>
      {shelves.map((shelf) => (
        <section
          class="catalog-shelf"
          id={`shelf-${shelf.id}`}
          aria-labelledby={`heading-${shelf.id}`}
          data-shelf
        >
          <div class="shelf-heading">
            <h2 id={`heading-${shelf.id}`}>{shelf.title[lang]}</h2>
            <div class="shelf-controls" data-shelf-controls hidden>
              <button
                type="button"
                data-shelf-prev
                aria-label={`${shelf.title[lang]}: ${tr ? 'sola kaydır' : 'scroll left'}`}
                aria-controls={`track-${shelf.id}`}
              >
                ←
              </button>
              <button
                type="button"
                data-shelf-next
                aria-label={`${shelf.title[lang]}: ${tr ? 'sağa kaydır' : 'scroll right'}`}
                aria-controls={`track-${shelf.id}`}
              >
                →
              </button>
            </div>
          </div>
          <div class="shelf-track" id={`track-${shelf.id}`} data-shelf-track>
            {catalogPosts
              .filter((post) => post.shelf === shelf.id)
              .map((post) => (
                <article
                  class={`catalog-card tone-${post.tone}`}
                  data-post-key={post.key}
                >
                  <h3>
                    <a
                      class="catalog-card-link"
                      href={post.path}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-describedby={`summary-${post.id}`}
                    >
                      <span class="card-turn">
                        <span class="card-face card-front">
                          <CatalogCover cover={post.cover} />
                          <span class="card-front-copy">
                            <span class="card-title" lang={post.lang}>
                              {post.title}
                            </span>
                            <span class="card-touch-summary" aria-hidden="true">
                              {post.description}
                            </span>
                          </span>
                        </span>
                        <span class="card-face card-back" aria-hidden="true">
                          <span class="card-back-date">
                            <time datetime={post.date}>
                              {formatPostDate(post.date, lang)}
                            </time>
                            <span>{post.lang === 'tr' ? 'TR' : 'EN'}</span>
                          </span>
                          <span class="card-summary">{post.description}</span>
                          <span class="card-read">
                            {open}
                            <span>↗</span>
                          </span>
                        </span>
                      </span>
                    </a>
                  </h3>
                  <p id={`summary-${post.id}`} class="sr-only">
                    {post.description} {newTab}.
                  </p>
                </article>
              ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<script>
  import { initBlogCatalog } from '../../lib/blog-catalog';
  document
    .querySelectorAll<HTMLElement>('[data-blog-catalog]')
    .forEach(initBlogCatalog);
</script>
