---
// Sparse, deterministic points avoid the entire heading/description band (28–60%).
const stars = [
  { x: 8, y: 18 },
  { x: 25, y: 23 },
  { x: 43, y: 9 },
  { x: 62, y: 21 },
  { x: 81, y: 13 },
  { x: 94, y: 25 },
  { x: 16, y: 8 },
  { x: 34, y: 18 },
  { x: 54, y: 25 },
  { x: 74, y: 7 },
  { x: 90, y: 19 },
  { x: 12, y: 67 },
  { x: 34, y: 74 },
  { x: 69, y: 65 },
  { x: 88, y: 77 },
  { x: 21, y: 79 },
  { x: 59, y: 72 },
  { x: 77, y: 81 },
].map((point, i) => ({
  ...point,
  size: i % 4 === 0 ? 2 : 1.25,
  duration: 6.4 + (i % 5) * 1.1,
  delay: -(i % 7) * 1.3,
}));
---

<div class="night-stars" aria-hidden="true">
  {stars.map((star, index) => (
    <span
      class:list={['night-star', { 'star-gilded': index % 4 === 0 }]}
      style={`left:${star.x}%;top:${star.y}%;--star-size:${star.size}px;--star-duration:${star.duration}s;--star-delay:${star.delay}s`}
    ></span>
  ))}
</div>
