<script is:inline>
  // Set before body parsing so content cannot flash ahead of the mirror.
  // Missing enhancement code releases the page after this bounded wait.
  try {
    const navigation = performance.getEntriesByType('navigation')[0];
    if (
      !location.hash &&
      !matchMedia('(prefers-reduced-motion: reduce)').matches &&
      navigation?.type !== 'back_forward'
    ) {
      document.documentElement.dataset.alamoriEntry = 'pending';
      setTimeout(() => {
        if (document.documentElement.dataset.alamoriEntry === 'pending')
          delete document.documentElement.dataset.alamoriEntry;
      }, 1800);
    }
  } catch {
    /* Plain content remains available. */
  }
</script>
<style is:inline>
  html[data-alamori-entry] {
    background: #141a1b;
  }
  html[data-alamori-entry='pending'] body > :not([data-mirror-arrival]),
  html[data-alamori-entry='running'] body > :not([data-mirror-arrival]) {
    visibility: hidden;
    opacity: 0;
  }
  html[data-alamori-entry='revealing'] body > :not([data-mirror-arrival]) {
    opacity: var(--alamori-content-opacity, 0);
  }
  @media (prefers-reduced-motion: reduce) {
    html[data-alamori-entry] body > :not([data-mirror-arrival]) {
      visibility: visible;
      opacity: 1;
    }
  }
</style>
