---
import type { Lang } from '../../lib/i18n';
import { href } from '../../lib/urls';
import '../../styles/alamori-entry.css';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = lang === 'tr';
---

<div
  class="alamori-entry"
  data-mirror-arrival
  data-earth={href('media/alamori-entry/earth-study.webp')}
  data-atlantis={href('media/alamori-entry/atlantis-forest.webp')}
  data-earth-label={tr ? 'Dünya' : 'Earth'}
  data-atlantis-label="Atlantis"
  role="dialog"
  aria-modal="true"
  aria-label={
    tr ? 'Alamori: aynanın eşiğinde' : 'Alamori: at the mirror’s threshold'
  }
  hidden
>
  <canvas data-arrival-canvas aria-hidden="true"></canvas>
  <div class="alamori-entry-shade" aria-hidden="true"></div>
  <div class="alamori-entry-topline">
    <span aria-hidden="true">mebegu.</span>
    <button type="button" data-arrival-skip>
      {tr ? 'Geçişi atla' : 'Skip the crossing'}{' '}
      <span aria-hidden="true">↗</span>
    </button>
  </div>
  <div class="alamori-entry-title" aria-hidden="true">
    <span class="alamori-entry-place" data-arrival-place>
      {tr ? 'Dünya' : 'Earth'}
    </span>
    <span class="alamori-entry-wordmark">
      Alamori<span>.</span>
    </span>
    <span class="alamori-entry-caption">
      {tr ? 'Aynanın eşiğinde' : 'At the mirror’s threshold'}
    </span>
  </div>
</div>

<script>
  import { initMirrorArrival } from '../../lib/alamori-entry';
  document
    .querySelectorAll<HTMLElement>('[data-mirror-arrival]')
    .forEach(initMirrorArrival);
</script>
