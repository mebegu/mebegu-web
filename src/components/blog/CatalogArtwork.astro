---
interface Props {
  art: 'interface' | 'landscape' | 'book' | 'orbit';
}
const { art } = Astro.props;
---

<svg
  class={`catalog-art catalog-art-${art}`}
  viewBox="0 0 640 400"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
>
  {art === 'interface' && (
    <>
      <circle cx="410" cy="184" r="133" class="art-halo" />
      <rect
        x="149"
        y="98"
        width="344"
        height="218"
        rx="9"
        class="art-surface"
      />
      <path
        d="M149 135h344M220 135v181M241 163h113M241 181h75M169 164h29M169 183h29M169 202h18"
        class="art-line"
      />
      <circle cx="169" cy="116" r="3" class="art-dot" />
      <circle cx="182" cy="116" r="3" class="art-dot" />
      <rect x="241" y="207" width="104" height="82" rx="4" class="art-window" />
      <rect x="360" y="207" width="110" height="82" rx="4" class="art-window" />
      <path
        d="m277 237-12 12 12 12m32-24 12 12-12 12m-18 8 6-40M385 268l18-20 15 8 23-29"
        class="art-line art-line-bright"
      />
      <path d="M117 333h407M445 77h57M474 49v57" class="art-line" />
    </>
  )}
  {art === 'landscape' && (
    <>
      <circle cx="423" cy="145" r="67" class="art-sun" />
      <path
        d="M73 320 220 160l133 160M258 320l141-124 166 124"
        class="art-mountain"
      />
      <path
        d="M76 322h489M117 342h410M173 360h300M211 322l38-62 34 23 26-25M353 318l44-58 46 29"
        class="art-line"
      />
      <path d="M125 105h112M98 122h170M475 220h90" class="art-line" />
      <path
        d="M292 353c-38-32 98-38 68-75-11-14-26-15-28-30"
        class="art-line art-line-bright"
      />
      <circle cx="151" cy="86" r="3" class="art-dot" />
    </>
  )}
  {art === 'book' && (
    <>
      <circle cx="354" cy="168" r="116" class="art-halo" />
      <path
        d="M142 160c60-15 116-4 177 30 61-34 117-45 177-30v153c-60-13-116-3-177 29-61-32-117-42-177-29V160Z"
        class="art-surface"
      />
      <path
        d="M319 190v152M162 185c46-4 87 4 133 26M162 210c46-4 87 4 133 26M162 235c46-4 87 4 133 26M162 260c46-4 87 4 133 26M345 211c46-22 87-30 130-26M345 236c46-22 87-30 130-26M345 261c46-22 87-30 130-26M345 286c46-22 87-30 130-26"
        class="art-line"
      />
      <path
        d="m321 65 5 16 16 5-16 5-5 16-5-16-16-5 16-5 5-16ZM395 112l4 11 11 4-11 4-4 11-4-11-11-4 11-4 4-11Z"
        class="art-dot"
      />
      <path d="M254 126v-18M245 117h18" class="art-line art-line-bright" />
    </>
  )}
  {art === 'orbit' && (
    <>
      <circle cx="333" cy="202" r="111" class="art-halo" />
      <circle cx="333" cy="202" r="74" class="art-line" />
      <ellipse
        cx="333"
        cy="202"
        rx="208"
        ry="67"
        transform="rotate(-27 333 202)"
        class="art-line art-line-bright"
      />
      <ellipse
        cx="333"
        cy="202"
        rx="166"
        ry="122"
        transform="rotate(34 333 202)"
        class="art-line"
      />
      <circle cx="333" cy="202" r="29" class="art-sun" />
      <circle cx="482" cy="113" r="12" class="art-dot" />
      <circle cx="212" cy="105" r="7" class="art-dot" />
      <path
        d="M128 272v24M116 284h24M469 295v16M461 303h16M138 84h61M168 68v32"
        class="art-line"
      />
    </>
  )}
</svg>
