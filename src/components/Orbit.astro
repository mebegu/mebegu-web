---
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<div class="orbit" aria-hidden="true">
  <svg viewBox="0 0 560 560" fill="none" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="sphere" cx="0.3" cy="0.2" r="0.85">
        <stop stop-color="#b2c9fa" />
        <stop offset="0.45" stop-color="#6688bf" />
        <stop offset="1" stop-color="#203347" />
      </radialGradient>
      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path
          d="M40 0H0V40"
          stroke="currentColor"
          stroke-width="0.5"
          opacity="0.2"
        />
      </pattern>
    </defs>
    <path
      d="M280 20V540M20 280H540"
      stroke="currentColor"
      stroke-dasharray="3 7"
      opacity="0.3"
    />
    <circle cx="280" cy="280" r="232" stroke="currentColor" opacity="0.14" />
    <circle
      cx="280"
      cy="280"
      r="190"
      fill="url(#grid)"
      stroke="currentColor"
      opacity="0.35"
    />
    <g class="orbit-rotation">
      <ellipse
        cx="280"
        cy="280"
        rx="256"
        ry="83"
        transform="rotate(-32 280 280)"
        stroke="#d9ae78"
        stroke-width="1.2"
      />
      <circle cx="65" cy="380" r="5" fill="#d9ae78" />
    </g>
    <circle cx="280" cy="280" r="134" fill="url(#sphere)" />
    <path
      d="M169 207C222 256 325 294 412 285M154 281C215 322 315 345 394 343M172 346C221 370 288 385 348 386"
      stroke="#d0def4"
      stroke-opacity="0.3"
    />
    <ellipse
      cx="280"
      cy="280"
      rx="54"
      ry="134"
      transform="rotate(-31 280 280)"
      stroke="#d0def4"
      stroke-opacity="0.3"
    />
    <path
      d="M54 54H70M62 46V62M490 506H506M498 498V514"
      stroke="currentColor"
      opacity="0.5"
    />
  </svg>
  <span class="orbit-caption">{caption}</span>
</div>
