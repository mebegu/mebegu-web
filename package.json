{
  "name": "mebegu-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "oracle:plan": "node scripts/oracle-plan.mjs",
    "oracle:browser": "node scripts/oracle-browser.mjs",
    "test:oracles": "node --test scripts/test-oracle-plan.mjs",
    "test:professional:browser": "node --test scripts/test-professional-browser.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "check:output": "node scripts/check-output.mjs && node scripts/check-blog-publication.mjs",
    "test:carousel": "node --test scripts/test-blog-banner.mjs",
    "test:workshop": "node --test scripts/test-workshop.mjs",
    "check:workshop": "node scripts/check-workshop.mjs",
    "test:alamori": "node --test scripts/test-alamori.mjs",
    "check:alamori": "node scripts/check-alamori.mjs",
    "validate": "node --test scripts/test-blog-banner.mjs scripts/test-workshop.mjs scripts/test-alamori.mjs scripts/test-oracle-plan.mjs && node scripts/check-workshop.mjs && node scripts/check-alamori.mjs && astro check && astro build && node scripts/check-output.mjs && node scripts/check-blog-publication.mjs",
    "format": "prettier --write src docs scripts README.md"
  },
  "dependencies": {
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3"
  }
}
