{
  "name": "mebegu-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "check:output": "node scripts/check-output.mjs",
    "validate": "astro check && astro build && node scripts/check-output.mjs",
    "format": "prettier --write src docs scripts README.md"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
}
